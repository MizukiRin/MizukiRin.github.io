---
// src/components/Header.astro
// 公共头部组件：包含终端标志、响应式导航栏 (About / Blog / Wiki)，以及全局统一的 GitHub 登录与账号菜单入口。

const pathname = Astro.url.pathname;
const isAboutActive = pathname.startsWith('/about');
const isProjectsActive = pathname.startsWith('/projects');
const isBlogActive = pathname.startsWith('/blog');
const isWikiActive = pathname.startsWith('/wiki');
---

<header class="py-8">
    <div class="max-w-3xl mx-auto px-6 flex justify-between items-center gap-4">
        <!-- 站点Logo/终端模拟提示 -->
        <a
            href="/"
            class="font-mono font-medium text-base sm:text-lg tracking-tight hover:text-neutral-600 transition-colors shrink-0"
        >
            mizuki@space:~$
        </a>

        <!-- 导航菜单 + 全局统一登录入口 -->
        <nav class="flex items-center space-x-4 sm:space-x-6 text-sm font-medium">
            <a
                href="/about"
                class={isAboutActive ? "text-neutral-900" : "text-neutral-500 hover:text-neutral-900 transition-colors"}
            >About</a>
            <!-- <a
                href="/projects"
                class={isProjectsActive ? "text-neutral-900" : "text-neutral-500 hover:text-neutral-900 transition-colors"}
            >Projects</a> -->
            <a
                href="/blog"
                class={isBlogActive ? "text-neutral-900" : "text-neutral-500 hover:text-neutral-900 transition-colors"}
            >Blog</a>
            <a
                href="/wiki"
                class={isWikiActive ? "text-neutral-900" : "text-neutral-500 hover:text-neutral-900 transition-colors"}
            >Wiki</a>

            <!-- 分隔线 -->
            <span class="text-neutral-200 select-none text-xs">|</span>

            <!-- 全局统一认证入口 -->
            <div id="global-auth-container" class="relative flex items-center">
                <!-- 未登录：极简 GitHub 登录图标按钮 -->
                <button
                    id="global-login-btn"
                    type="button"
                    class="w-7 h-7 flex items-center justify-center text-neutral-400 hover:text-neutral-900 rounded hover:bg-neutral-100 transition-colors cursor-pointer"
                    title="GitHub 登录"
                    aria-label="GitHub 登录"
                >
                    <i class="ph ph-github-logo text-base"></i>
                </button>

                <!-- 已登录：圆形头像 + 下拉菜单 -->
                <div id="global-user-menu-wrapper" class="hidden relative items-center">
                    <button
                        id="global-avatar-btn"
                        type="button"
                        class="flex items-center space-x-1 rounded-full p-0.5 border border-neutral-200 hover:border-neutral-400 transition-colors cursor-pointer focus:outline-none"
                        title="账号菜单"
                    >
                        <img
                            id="global-user-avatar"
                            src=""
                            alt="avatar"
                            class="w-5 h-5 rounded-full object-cover"
                        />
                    </button>

                    <!-- 下拉菜单 -->
                    <div
                        id="global-user-dropdown"
                        class="hidden absolute right-0 top-9 w-44 bg-white border border-neutral-200 rounded-sm shadow-lg py-1.5 z-50 font-mono text-xs animate-fade-in"
                    >
                        <div class="px-3 py-1.5 border-b border-neutral-100 space-y-0.5">
                            <div id="global-user-name" class="text-neutral-900 font-medium truncate"></div>
                            <div id="global-user-role" class="text-[10px] text-neutral-400"></div>
                        </div>
                        <a
                            href="/wiki"
                            class="flex items-center space-x-2 px-3 py-1.5 text-neutral-600 hover:text-neutral-900 hover:bg-neutral-50 transition-colors"
                        >
                            <i class="ph ph-lock-simple text-xs"></i>
                            <span>私密 Wiki</span>
                        </a>
                        <button
                            id="global-logout-btn"
                            type="button"
                            class="w-full flex items-center space-x-2 px-3 py-1.5 text-left text-neutral-500 hover:text-red-600 hover:bg-red-50/60 transition-colors cursor-pointer"
                        >
                            <i class="ph ph-sign-out text-xs"></i>
                            <span>退出登录</span>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </div>
</header>

<script>
    import { supabase, AUTHOR_GITHUB } from "../utils/supabase";

    const globalLoginBtn = document.getElementById("global-login-btn");
    const globalUserWrapper = document.getElementById("global-user-menu-wrapper");
    const globalAvatarBtn = document.getElementById("global-avatar-btn");
    const globalUserAvatar = document.getElementById("global-user-avatar") as HTMLImageElement | null;
    const globalUserDropdown = document.getElementById("global-user-dropdown");
    const globalUserName = document.getElementById("global-user-name");
    const globalUserRole = document.getElementById("global-user-role");
    const globalLogoutBtn = document.getElementById("global-logout-btn");

    function updateGlobalAuthUI(user: any) {
        if (user) {
            const ghUsername = user.user_metadata?.user_name || user.email?.split("@")[0] || "user";
            const isAuthor = ghUsername.toLowerCase() === AUTHOR_GITHUB.toLowerCase();

            globalLoginBtn?.classList.add("hidden");
            if (globalUserWrapper) {
                globalUserWrapper.classList.remove("hidden");
                globalUserWrapper.classList.add("flex");
            }

            if (globalUserAvatar) {
                globalUserAvatar.src = user.user_metadata?.avatar_url || `https://avatars.githubusercontent.com/${ghUsername}`;
            }
            if (globalUserName) globalUserName.textContent = `@${ghUsername}`;
            if (globalUserRole) globalUserRole.textContent = isAuthor ? "博主 (Author)" : "访客账号";
        } else {
            globalLoginBtn?.classList.remove("hidden");
            if (globalUserWrapper) {
                globalUserWrapper.classList.add("hidden");
                globalUserWrapper.classList.remove("flex");
            }
            globalUserDropdown?.classList.add("hidden");
        }
    }

    globalLoginBtn?.addEventListener("click", async () => {
        try {
            // 如果当前在 /blog 下的特定 Tab，保留 Tab 状态方便登录后返回
            const activeTab = document.querySelector(".tab-btn.border-neutral-900")?.getAttribute("data-target");
            const redirectUrl = activeTab
                ? `${window.location.origin}${window.location.pathname}?tab=${activeTab}`
                : window.location.href;

            const { error } = await supabase.auth.signInWithOAuth({
                provider: "github",
                options: {
                    redirectTo: redirectUrl,
                },
            });
            if (error) {
                console.error("GitHub 登录失败:", error);
                alert("登录失败: " + error.message);
            }
        } catch (err: any) {
            console.error("登录异常:", err);
            alert("登录异常: " + (err.message || err));
        }
    });

    globalAvatarBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        globalUserDropdown?.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
        if (globalUserWrapper && !globalUserWrapper.contains(e.target as Node)) {
            globalUserDropdown?.classList.add("hidden");
        }
    });

    globalLogoutBtn?.addEventListener("click", async () => {
        try {
            await supabase.auth.signOut();
        } catch (e) {
            console.error("退出异常:", e);
        }
        window.location.reload();
    });

    supabase.auth.onAuthStateChange((_event, session) => {
        updateGlobalAuthUI(session?.user || null);
    });
</script>
