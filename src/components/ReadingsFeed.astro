---
// src/components/ReadingsFeed.astro
// 精读/企业博客书签 (Readings) 组件
// 包含与 Daily Notes 完全一致的 GitHub 登录/登出面板与博主身份鉴权
// 支持结构化卡片渲染 (原文直达、复制URL、Notes横线区、标签分类)、手机端轻量快速发布、标签过滤与删除
---

<div id="readings-feed-container" class="space-y-6">
  <!-- 顶部状态栏与操作栏 -->
  <div class="flex flex-wrap items-center justify-between gap-y-2 border-b border-neutral-100 pb-3">
    <div class="flex items-center space-x-2">
      <span class="text-xs font-mono uppercase tracking-wider text-neutral-400">Readings</span>
      <span id="readings-count-badge" class="hidden text-[11px] font-mono bg-neutral-100 text-neutral-600 px-1.5 py-0.5 rounded">0</span>
    </div>

    <!-- 博主操作面板 (统一登录入口已移至顶部全局导航栏) -->
    <div id="readings-auth-section" class="flex items-center space-x-2.5 text-xs font-mono">
      <!-- 已登录状态 (仅博主显示添加与标签管理按钮) -->
      <div id="readings-user-panel" class="hidden items-center space-x-2 sm:space-x-2.5">
        <!-- 添加精读按钮：移动端纯方形小胶囊图标且居中，桌面端带文字 -->
        <button
          id="readings-toggle-compose-btn"
          class="hidden w-7 h-7 sm:w-auto sm:h-auto flex items-center justify-center sm:space-x-1 bg-neutral-900 hover:bg-neutral-800 text-white rounded sm:px-2.5 sm:py-1 transition-colors shadow-xs cursor-pointer whitespace-nowrap select-none"
          title="添加精读"
        >
          <i class="ph ph-plus text-sm flex items-center justify-center"></i>
          <span class="hidden sm:inline">添加精读</span>
        </button>

        <!-- 标签管理按钮：专属方形小图标按钮，仅博主可见 -->
        <button
          id="readings-open-tag-manager-btn"
          class="hidden w-7 h-7 flex items-center justify-center text-neutral-400 hover:text-neutral-900 rounded hover:bg-neutral-100 transition-colors cursor-pointer select-none"
          title="技术标签管理"
        >
          <i class="ph ph-tag text-sm"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- 轻量发布表单 (仅博主登录展开) -->
  <div id="readings-composer" class="hidden bg-white border border-neutral-200 rounded-sm p-4 space-y-3.5 shadow-xs animate-fade-in text-xs font-mono">
    <div class="flex items-center justify-between pb-1 border-b border-neutral-100">
      <span id="readings-composer-title" class="font-medium text-neutral-800">记录阅读笔记</span>
      <span id="readings-composer-subtitle" class="text-[11px] text-neutral-400">支持手机快速粘贴 URL 与要点思考</span>
    </div>

    <!-- 1. 原文链接 (必填) -->
    <div class="space-y-1">
      <label for="readings-input-url" class="block text-[11px] text-neutral-500">原文链接 (URL) *</label>
      <div class="relative">
        <i class="ph ph-link absolute left-2.5 top-1/2 -translate-y-1/2 text-neutral-400"></i>
        <input
          id="readings-input-url"
          type="url"
          placeholder="https://eng.uber.com/... 或 https://blog.cloudflare.com/..."
          class="w-full bg-neutral-50/60 border border-neutral-200 rounded px-2.5 py-1.5 pl-8 text-xs text-neutral-900 placeholder:text-neutral-300 focus:outline-none focus:border-neutral-900 transition-colors font-mono"
        />
      </div>
    </div>

    <!-- 2. 原文标题与来源机构 -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
      <div class="sm:col-span-2 space-y-1">
        <label for="readings-input-title" class="block text-[11px] text-neutral-500">阅读的文章原标题 *</label>
        <input
          id="readings-input-title"
          type="text"
          placeholder="例如：How Uber Scaled Its Distributed Storage to Thousands of Nodes"
          class="w-full bg-neutral-50/60 border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-900 placeholder:text-neutral-300 focus:outline-none focus:border-neutral-900 transition-colors font-sans"
        />
      </div>
      <div class="space-y-1">
        <label for="readings-input-source" class="block text-[11px] text-neutral-500">来源 / 企业机构</label>
        <input
          id="readings-input-source"
          type="text"
          placeholder="如 Uber, OpenAI, Stripe"
          class="w-full bg-neutral-50/60 border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-900 placeholder:text-neutral-300 focus:outline-none focus:border-neutral-900 transition-colors font-mono"
        />
      </div>
    </div>

    <!-- 快捷来源小按钮 -->
    <div class="flex flex-wrap items-center gap-1.5 text-[10px] text-neutral-400">
      <span>常用:</span>
      {["Uber", "Cloudflare", "OpenAI", "Anthropic", "Stripe", "Netflix", "Google", "Meta", "Paper"].map((src) => (
        <button
          type="button"
          class="readings-quick-source-btn px-1.5 py-0.5 rounded bg-neutral-100 hover:bg-neutral-200 text-neutral-600 transition-colors cursor-pointer select-none"
          data-source={src}
        >
          {src}
        </button>
      ))}
    </div>

    <!-- 3. 核心思考 / 要点笔记 (多行) -->
    <div class="space-y-1">
      <div class="flex items-center justify-between text-[11px] text-neutral-500">
        <label for="readings-input-summary">我的精读笔记与思考 (Notes) *</label>
        <span class="text-[10px] text-neutral-400">支持 Markdown 排版</span>
      </div>
      <textarea
        id="readings-input-summary"
        rows="4"
        placeholder="记录这篇文章的核心启发、要点、设计权衡...&#10;1. 选主超时增加了自适应抖动设计&#10;2. 增量快照同步降低了 40% 内存峰值"
        class="w-full bg-neutral-50/60 border border-neutral-200 rounded p-2.5 text-xs text-neutral-900 placeholder:text-neutral-300 focus:outline-none focus:border-neutral-900 transition-colors font-sans leading-relaxed resize-y"
      ></textarea>
    </div>

    <!-- 4. 标签选择与录入区 (标签胶囊化) -->
    <div class="space-y-1.5 pt-1">
      <div class="flex items-center justify-between text-[11px] text-neutral-500">
        <span>技术标签 (按回车或点添加)</span>
        <span class="text-[10px] text-neutral-400">可多选</span>
      </div>

      <!-- 已选标签胶囊预览容器 -->
      <div id="readings-selected-tags-container" class="flex flex-wrap items-center gap-1.5 min-h-[26px]">
        <!-- 标签胶囊由 JS 动态生成 -->
      </div>

      <!-- 标签输入框与添加按钮 -->
      <div class="flex items-center gap-2">
        <div class="relative grow">
          <i class="ph ph-hash absolute left-2.5 top-1/2 -translate-y-1/2 text-neutral-400 text-xs"></i>
          <input
            id="readings-input-tag"
            type="text"
            placeholder="输入标签名，按 Enter 添加 (如 Architecture)"
            class="w-full bg-neutral-50/60 border border-neutral-200 rounded px-2.5 py-1.5 pl-7 text-xs text-neutral-900 placeholder:text-neutral-300 focus:outline-none focus:border-neutral-900 transition-colors font-mono"
          />
        </div>
        <button
          id="readings-btn-add-tag"
          type="button"
          class="px-3 py-1.5 bg-neutral-100 hover:bg-neutral-200 text-neutral-800 rounded text-xs transition-colors cursor-pointer select-none shrink-0"
        >
          添加标签
        </button>
      </div>

      <!-- 快捷标签推荐池 -->
      <div id="readings-suggested-tags-wrapper" class="hidden flex flex-wrap items-center gap-1 pt-1 text-[10px] text-neutral-400">
        <span>已有标签:</span>
        <div id="readings-suggested-tags-list" class="flex flex-wrap items-center gap-1"></div>
      </div>
    </div>

    <!-- 操作按钮与可见性勾选 -->
    <div class="flex items-center justify-between pt-2 border-t border-neutral-100 gap-2">
      <label class="flex items-center space-x-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-800 cursor-pointer select-none transition-colors" title="勾选后仅博主登录后可见，访客不可见">
        <input
          type="checkbox"
          id="readings-private-input"
          class="rounded border-neutral-300 text-neutral-900 focus:ring-0 w-3.5 h-3.5 cursor-pointer accent-neutral-900"
        />
        <span class="flex items-center space-x-1">
          <svg class="w-3.5 h-3.5 text-neutral-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 10s3.5 6 10 6 10-6 10-6"/>
            <path d="M5 13.5L3 17"/>
            <path d="M9 16L8 20"/>
            <path d="M15 16L16 20"/>
            <path d="M19 13.5L21 17"/>
          </svg>
          <span>仅我可见</span>
        </span>
      </label>

      <div class="flex items-center space-x-2">
        <button
          id="readings-cancel-compose-btn"
          type="button"
          class="px-3 py-1.5 text-neutral-400 hover:text-neutral-800 rounded transition-colors cursor-pointer select-none"
        >
          取消
        </button>
        <button
          id="readings-submit-btn"
          type="button"
          class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 bg-neutral-900 hover:bg-neutral-800 text-white rounded transition-colors cursor-pointer select-none"
        >
          <span id="readings-submit-spinner" class="hidden"><i class="ph ph-spinner animate-spin text-xs"></i></span>
          <span id="readings-submit-text">发布记录</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 标签筛选栏 (有标签时展示，支持按标签过滤) -->
  <div id="readings-filter-bar" class="hidden flex items-center gap-1.5 flex-wrap pt-1 pb-1 font-mono text-xs select-none">
    <span class="text-neutral-400 mr-0.5 flex items-center text-[11px]">
      <i class="ph ph-funnel text-xs mr-1"></i>标签:
    </span>
    <button
      id="readings-filter-all-btn"
      type="button"
      class="inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-900 text-white transition-colors cursor-pointer"
    >
      全部
    </button>
    <div id="readings-filter-list" class="flex items-center gap-1.5 flex-wrap">
      <!-- 动态注入标签过滤胶囊 -->
    </div>
  </div>

  <!-- 骨架屏加载状态 -->
  <div id="readings-skeleton" class="space-y-4">
    {[1, 2, 3].map(() => (
      <div class="border border-neutral-200/80 rounded-sm p-4 space-y-3 bg-white/60 animate-pulse">
        <div class="flex justify-between items-center">
          <div class="h-4 bg-neutral-200 rounded w-28"></div>
          <div class="h-3 bg-neutral-100 rounded w-16"></div>
        </div>
        <div class="h-5 bg-neutral-200 rounded w-3/4"></div>
        <div class="space-y-1.5">
          <div class="h-3.5 bg-neutral-100 rounded w-full"></div>
          <div class="h-3.5 bg-neutral-100 rounded w-5/6"></div>
        </div>
      </div>
    ))}
  </div>

  <!-- 动态列表卡片流容器 -->
  <div id="readings-list-container" class="space-y-4">
    <!-- JS 动态渲染卡片 -->
  </div>

  <!-- 空状态提示 -->
  <div id="readings-empty-state" class="hidden text-center py-16 text-neutral-400 font-mono text-xs space-y-2">
    <i class="ph ph-book-open text-3xl mb-1 block text-neutral-300"></i>
    <p>No reading notes yet.</p>
    <div id="readings-setup-tip" class="hidden text-[11px] text-neutral-400 pt-2 max-w-md mx-auto text-left bg-neutral-50 p-3 rounded border border-neutral-200">
      <span class="font-medium text-neutral-700 block mb-1">💡 首次使用提示：</span>
      请在 Supabase SQL Editor 中执行项目根目录下的 <code class="bg-neutral-200 px-1 rounded">supabase_readings_schema.sql</code> 即可快速初始化数据库表。
    </div>
  </div>

  <!-- 分页加载更多 -->
  <div id="readings-pagination" class="hidden text-center pt-2">
    <button
      id="readings-load-more-btn"
      type="button"
      class="inline-flex items-center space-x-1.5 text-xs font-mono text-neutral-500 hover:text-neutral-900 border border-neutral-200 hover:border-neutral-400 bg-white px-3.5 py-1.5 rounded transition-all shadow-2xs cursor-pointer select-none"
    >
      <i id="readings-load-more-icon" class="ph ph-arrow-down text-xs"></i>
      <span id="readings-load-more-text">加载更多记录</span>
    </button>
  </div>

  <!-- 精读技术标签管理模态弹窗 (仅博主可用：支持新建、改名、删除，并级联同步历史精读笔记) -->
  <div id="readings-tag-manager-modal" class="hidden fixed inset-0 z-[999] bg-black/45 backdrop-blur-xs flex items-center justify-center p-4 transition-all">
    <div class="bg-neutral-50/95 border border-neutral-300/80 rounded-sm shadow-xl max-w-md w-full p-5 sm:p-6 space-y-4 animate-scale-in font-mono text-xs">
      <!-- 头部 -->
      <div class="flex items-center justify-between pb-2 border-b border-neutral-200/80">
        <div class="flex items-center space-x-2">
          <i class="ph ph-tag text-base text-neutral-800"></i>
          <h4 class="text-sm font-semibold text-neutral-900">精读技术标签管理</h4>
        </div>
        <button id="readings-tag-manager-close-icon-btn" type="button" class="text-neutral-400 hover:text-neutral-800 cursor-pointer p-1" title="关闭">
          <i class="ph ph-x text-base"></i>
        </button>
      </div>

      <!-- 顶部新建标签输入栏 -->
      <div class="flex items-center gap-2">
        <input
          id="readings-tag-manager-new-input"
          type="text"
          placeholder="输入新技术标签名称 (如 Distributed)..."
          class="grow bg-white border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-800 placeholder:text-neutral-400 focus:outline-none focus:border-neutral-800 transition-colors"
        />
        <button
          id="readings-tag-manager-add-btn"
          type="button"
          class="inline-flex items-center space-x-1 bg-neutral-900 hover:bg-neutral-800 text-white text-xs px-3 py-1.5 rounded transition-colors cursor-pointer select-none shrink-0"
        >
          <i class="ph ph-plus"></i>
          <span>新建</span>
        </button>
      </div>

      <!-- 标签列表区 (含使用统计与编辑/删除按钮) -->
      <div class="space-y-1">
        <div class="text-[11px] text-neutral-400 flex justify-between items-center px-1">
          <span>技术标签库</span>
          <span id="readings-tag-manager-total-count" class="text-neutral-400">共 0 个标签</span>
        </div>
        <div id="readings-tag-manager-list" class="max-h-64 overflow-y-auto space-y-1 pr-1 border border-neutral-200/60 rounded bg-white p-2">
          <!-- 标签项由 JS 动态生成 -->
        </div>
      </div>

      <!-- 底部操作与说明 -->
      <div class="flex items-center justify-between pt-2 border-t border-neutral-200/80 text-[11px] text-neutral-400">
        <span>修改或删除标签会同步更新关联的精读笔记</span>
        <button
          id="readings-tag-manager-close-btn"
          type="button"
          class="text-xs bg-neutral-100 hover:bg-neutral-200 text-neutral-800 px-3.5 py-1.5 rounded transition-colors cursor-pointer select-none"
        >
          完成
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { supabase, AUTHOR_GITHUB } from "../utils/supabase";
  import { renderMarkdown } from "../utils/markdown";

  interface ReadingItem {
    id: string;
    title: string;
    url: string;
    source?: string;
    summary: string;
    tags?: string[];
    author_github: string;
    is_private?: boolean;
    created_at: string;
  }

  const closedEyeSvg = `
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 10s3.5 6 10 6 10-6 10-6"/>
      <path d="M5 13.5L3 17"/>
      <path d="M9 16L8 20"/>
      <path d="M15 16L16 20"/>
      <path d="M19 13.5L21 17"/>
    </svg>
  `;

  // 状态栏与操作面板 DOM 元素引用
  const countBadge = document.getElementById("readings-count-badge");
  const userPanel = document.getElementById("readings-user-panel");
  const toggleComposeBtn = document.getElementById("readings-toggle-compose-btn");
  const openTagManagerBtn = document.getElementById("readings-open-tag-manager-btn");

  // 标签管理相关 DOM 元素
  const tagManagerModal = document.getElementById("readings-tag-manager-modal");
  const tagManagerCloseBtn = document.getElementById("readings-tag-manager-close-btn");
  const tagManagerCloseIconBtn = document.getElementById("readings-tag-manager-close-icon-btn");
  const tagManagerNewInput = document.getElementById("readings-tag-manager-new-input") as HTMLInputElement | null;
  const tagManagerAddBtn = document.getElementById("readings-tag-manager-add-btn");
  const tagManagerList = document.getElementById("readings-tag-manager-list");
  const tagManagerTotalCount = document.getElementById("readings-tag-manager-total-count");

  const composer = document.getElementById("readings-composer");
  const composerTitle = document.getElementById("readings-composer-title");
  const composerSubtitle = document.getElementById("readings-composer-subtitle");
  const cancelComposeBtn = document.getElementById("readings-cancel-compose-btn");
  const submitBtn = document.getElementById("readings-submit-btn");
  const submitText = document.getElementById("readings-submit-text");
  const submitSpinner = document.getElementById("readings-submit-spinner");

  const inputUrl = document.getElementById("readings-input-url") as HTMLInputElement | null;
  const inputTitle = document.getElementById("readings-input-title") as HTMLInputElement | null;
  const inputSource = document.getElementById("readings-input-source") as HTMLInputElement | null;
  const inputSummary = document.getElementById("readings-input-summary") as HTMLTextAreaElement | null;
  const inputPrivate = document.getElementById("readings-private-input") as HTMLInputElement | null;
  const quickSourceBtns = document.querySelectorAll(".readings-quick-source-btn");

  // 标签选择与录入 DOM
  const inputTag = document.getElementById("readings-input-tag") as HTMLInputElement | null;
  const btnAddTag = document.getElementById("readings-btn-add-tag");
  const selectedTagsContainer = document.getElementById("readings-selected-tags-container");
  const suggestedTagsWrapper = document.getElementById("readings-suggested-tags-wrapper");
  const suggestedTagsList = document.getElementById("readings-suggested-tags-list");

  let editingReadingId: string | null = null;
  let draftTags: string[] = [];
  const expandedReadingIds = new Set<string>();

  const filterBar = document.getElementById("readings-filter-bar");
  const filterAllBtn = document.getElementById("readings-filter-all-btn");
  const filterList = document.getElementById("readings-filter-list");

  const skeleton = document.getElementById("readings-skeleton");
  const listContainer = document.getElementById("readings-list-container");
  const emptyState = document.getElementById("readings-empty-state");
  const setupTip = document.getElementById("readings-setup-tip");
  const pagination = document.getElementById("readings-pagination");
  const loadMoreBtn = document.getElementById("readings-load-more-btn") as HTMLButtonElement | null;
  const loadMoreText = document.getElementById("readings-load-more-text");
  const loadMoreIcon = document.getElementById("readings-load-more-icon");

  const PAGE_SIZE = 10;
  let currentPage = 0;
  let totalCount = 0;
  let hasMore = false;
  let isLoading = false;
  let currentTagFilter: string | null = null;

  // 标签系统全局状态 (统一 daily_tags 表，通过 type = 'reading' 与 daily_notes 严格隔离)
  let tagUsageMap: Record<string, number> = {};
  let activeFilterTags: string[] = [];
  let allReadingTags: string[] = [];

  let currentUser: any = null;
  let isAuthor = false;

  // 渲染表单内已选标签胶囊
  function renderDraftTags() {
    if (!selectedTagsContainer) return;
    selectedTagsContainer.innerHTML = "";
    if (draftTags.length === 0) {
      selectedTagsContainer.innerHTML = `<span class="text-[11px] text-neutral-300 select-none">暂未添加标签</span>`;
      return;
    }
    draftTags.forEach((tag) => {
      const chip = document.createElement("span");
      chip.className = "inline-flex items-center gap-1 text-[11px] font-mono bg-neutral-100 text-neutral-800 px-2 py-0.5 rounded border border-neutral-200/80 shadow-2xs select-none";
      chip.innerHTML = `
        <span>#${tag}</span>
        <button type="button" class="text-neutral-400 hover:text-neutral-800 cursor-pointer p-0.5" title="移除标签">
          <i class="ph ph-x text-[10px]"></i>
        </button>
      `;
      chip.querySelector("button")?.addEventListener("click", () => {
        draftTags = draftTags.filter((t) => t !== tag);
        renderDraftTags();
      });
      selectedTagsContainer.appendChild(chip);
    });
  }

  // 渲染表单下方的推荐标签池 (仅展示 Readings 的技术标签，彻底与 Daily Notes 生活碎碎念隔离)
  function renderSuggestedTags() {
    if (!suggestedTagsWrapper || !suggestedTagsList) return;
    const existing = allReadingTags.filter((t) => !draftTags.includes(t));
    if (existing.length === 0) {
      suggestedTagsWrapper.classList.add("hidden");
      return;
    }
    suggestedTagsWrapper.classList.remove("hidden");
    suggestedTagsList.innerHTML = "";
    existing.slice(0, 12).forEach((t) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "px-1.5 py-0.5 rounded bg-neutral-100 hover:bg-neutral-200 text-neutral-600 transition-colors cursor-pointer select-none";
      btn.textContent = `+ #${t}`;
      btn.addEventListener("click", () => {
        if (!draftTags.includes(t)) {
          draftTags.push(t);
          renderDraftTags();
          renderSuggestedTags();
        }
      });
      suggestedTagsList.appendChild(btn);
    });
  }

  function addTagFromInput() {
    if (!inputTag) return;
    const val = inputTag.value.replace(/^#/, "").trim();
    if (!val) return;
    if (!draftTags.includes(val)) {
      draftTags.push(val);
      if (!allReadingTags.includes(val)) {
        allReadingTags.push(val);
        allReadingTags.sort((a, b) => a.localeCompare(b, "zh-CN"));
      }
      renderDraftTags();
      renderSuggestedTags();
    }
    inputTag.value = "";
    inputTag.focus();
  }

  btnAddTag?.addEventListener("click", addTagFromInput);
  inputTag?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addTagFromInput();
    }
  });

  // 格式化卡片日期
  function formatReadingDate(dateStr: string): string {
    try {
      const d = new Date(dateStr);
      return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
    } catch {
      return dateStr;
    }
  }

  // Markdown 安全渲染（支持标题、列表、代码块、表格与自动识别裸链接）
  function formatSummaryText(text: string): string {
    return renderMarkdown((text || "").trim(), { autoLinkUrls: true });
  }

  // 提取 Hostname 兜底显示
  function getHostname(url: string): string {
    try {
      const parsed = new URL(url);
      return parsed.hostname.replace(/^www\./, "");
    } catch {
      return "";
    }
  }

  // 渲染单张卡片
  function renderReadingCard(item: ReadingItem): HTMLElement {
    const card = document.createElement("article");
    card.id = `reading-${item.id}`;
    card.className = "group border border-neutral-200/90 hover:border-neutral-400 bg-white rounded-sm p-4 sm:p-5 space-y-3 transition-all hover:shadow-xs";

    const host = getHostname(item.url);
    const sourceLabel = item.source?.trim() || host || "External Article";
    const tags = (item.tags || []).filter((t) => Boolean(t.trim()));
    const isNotesExpanded = expandedReadingIds.has(item.id);
    const isPriv = Boolean(item.is_private);

    card.innerHTML = `
      <!-- 卡片头部: 来源标识 + 日期 + 复制链接 + 博主操作 -->
      <div class="flex items-center justify-between text-xs font-mono pb-1 border-b border-neutral-100 gap-2">
        <div class="flex items-center space-x-2 truncate min-w-0">
          <span class="inline-flex items-center space-x-1 px-1.5 py-0.5 bg-neutral-100 text-neutral-800 rounded font-medium text-[11px] truncate">
            <i class="ph ph-buildings text-[11px] text-neutral-500 shrink-0"></i>
            <span class="truncate">${sourceLabel}</span>
          </span>
          <span class="text-neutral-300">·</span>
          <time class="text-neutral-400 text-[11px] shrink-0">${formatReadingDate(item.created_at)}</time>
          ${
            isPriv
              ? `<span class="reading-private-badge inline-flex items-center space-x-0.5 px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-500 text-[10px] shrink-0" title="仅博主自己可见">${closedEyeSvg}<span>私密</span></span>`
              : `<span class="reading-private-badge hidden inline-flex items-center space-x-0.5 px-1.5 py-0.5 rounded bg-neutral-100 text-neutral-500 text-[10px] shrink-0" title="仅博主自己可见">${closedEyeSvg}<span>私密</span></span>`
          }
        </div>

        <div class="flex items-center space-x-1.5 shrink-0">
          <!-- 复制 URL 按钮 (轻量不显眼) -->
          <button
            type="button"
            class="btn-copy-url text-neutral-400 hover:text-neutral-800 p-1 rounded hover:bg-neutral-100 cursor-pointer transition-colors flex items-center justify-center"
            title="复制原文链接"
            data-url="${item.url}"
          >
            <i class="ph ph-copy text-xs"></i>
          </button>

          ${
            isAuthor
              ? `<button
                  type="button"
                  class="btn-privacy-reading ${isPriv ? "text-neutral-700 hover:text-neutral-900" : "text-neutral-350 hover:text-neutral-700"} p-1 rounded hover:bg-neutral-100 cursor-pointer transition-colors flex items-center justify-center"
                  title="${isPriv ? "当前状态：仅我可见（点击公开）" : "当前状态：公开（点击设为仅我可见）"}"
                >
                  ${isPriv ? closedEyeSvg : '<i class="ph ph-eye text-sm"></i>'}
                </button>
                <button type="button" class="btn-edit-reading text-neutral-400 hover:text-neutral-800 p-1 rounded hover:bg-neutral-100 cursor-pointer transition-colors" title="编辑此条记录">
                  <i class="ph ph-pencil-simple text-xs"></i>
                 </button>
                 <button type="button" class="btn-del-reading text-neutral-350 hover:text-red-600 p-1 rounded hover:bg-neutral-100 cursor-pointer transition-colors" title="删除此条记录">
                  <i class="ph ph-trash text-xs"></i>
                 </button>`
              : ""
          }
        </div>
      </div>

      <!-- 阅读的文章原标题 (单点跳转原文) -->
      <div>
        <h3 class="text-base font-medium text-neutral-900 leading-snug">
          <a
            href="${item.url}"
            target="_blank"
            rel="noopener noreferrer"
            class="group-hover:text-neutral-900 hover:underline decoration-neutral-300 underline-offset-4 inline-flex items-baseline gap-1"
            title="新窗口打开原文"
          >
            <span>${item.title}</span>
            <i class="ph ph-arrow-up-right text-xs text-neutral-400 group-hover:text-neutral-900 transition-colors shrink-0"></i>
          </a>
        </h3>
      </div>

      <!-- 文章标题下方的横线分割线与 Notes 折叠区 -->
      <div class="border-t border-neutral-200 pt-2.5 space-y-2">
        <!-- > Notes 折叠触发行 -->
        <button
          type="button"
          class="btn-toggle-notes w-full text-left inline-flex items-center space-x-1 text-xs font-light ${isNotesExpanded ? "text-neutral-700" : "text-neutral-400"} hover:text-neutral-800 font-mono tracking-wide transition-colors cursor-pointer select-none"
          aria-expanded="${isNotesExpanded ? "true" : "false"}"
        >
          <i class="notes-caret ph ${isNotesExpanded ? "ph-caret-down" : "ph-caret-right"} text-[11px]"></i>
          <span>Notes</span>
        </button>

        <!-- 总结正文 (Markdown 渲染，默认折叠，点击 Notes 展开/收起) -->
        <div class="notes-body ${isNotesExpanded ? "block" : "hidden"} prose compact-prose max-w-none font-sans break-words text-left">${formatSummaryText(item.summary)}</div>
      </div>

      <!-- 标签池 -->
      ${
        tags.length > 0
          ? `<div class="flex flex-wrap items-center gap-1.5 pt-1">
              ${tags
                .map((t) => {
                  const clean = t.replace(/^#/, "").trim();
                  const isActive = currentTagFilter === clean;
                  return `<button
                    type="button"
                    class="reading-tag-btn text-[11px] font-mono px-1.5 py-0.5 rounded cursor-pointer transition-colors select-none ${
                      isActive
                        ? "bg-neutral-900 text-white border border-neutral-900"
                        : "bg-neutral-50 hover:bg-neutral-100 text-neutral-500 hover:text-neutral-900 border border-neutral-200/60"
                    }"
                    data-tag="${clean}"
                  >#${clean}</button>`;
                })
                .join("")}
            </div>`
          : ""
      }
    `;

    // 绑定 Notes 折叠展开切换
    const toggleNotesBtn = card.querySelector(".btn-toggle-notes");
    const notesCaret = card.querySelector(".notes-caret");
    const notesBody = card.querySelector(".notes-body");
    toggleNotesBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const willExpand = !expandedReadingIds.has(item.id);
      if (willExpand) {
        expandedReadingIds.add(item.id);
      } else {
        expandedReadingIds.delete(item.id);
      }
      toggleNotesBtn.setAttribute("aria-expanded", willExpand ? "true" : "false");
      toggleNotesBtn.classList.toggle("text-neutral-700", willExpand);
      toggleNotesBtn.classList.toggle("text-neutral-400", !willExpand);
      notesCaret?.classList.toggle("ph-caret-down", willExpand);
      notesCaret?.classList.toggle("ph-caret-right", !willExpand);
      notesBody?.classList.toggle("hidden", !willExpand);
      notesBody?.classList.toggle("block", willExpand);
    });

    // 绑定复制 URL 逻辑
    const copyBtn = card.querySelector(".btn-copy-url");
    copyBtn?.addEventListener("click", async (e) => {
      e.stopPropagation();
      try {
        await navigator.clipboard.writeText(item.url);
        copyBtn.innerHTML = '<i class="ph ph-check text-xs text-neutral-900"></i>';
        setTimeout(() => {
          copyBtn.innerHTML = '<i class="ph ph-copy text-xs"></i>';
        }, 1500);
      } catch (err) {
        console.error("复制失败:", err);
      }
    });

    // 绑定博主操作 (可见性切换、编辑与删除)
    if (isAuthor) {
      const privacyBtn = card.querySelector(".btn-privacy-reading") as HTMLButtonElement | null;
      const privateBadge = card.querySelector(".reading-private-badge") as HTMLElement | null;
      privacyBtn?.addEventListener("click", async (e) => {
        e.stopPropagation();
        await handleToggleReadingPrivacy(item, !Boolean(item.is_private), privacyBtn, privateBadge);
      });

      const editBtn = card.querySelector(".btn-edit-reading");
      editBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        openEditReading(item);
      });

      const delBtn = card.querySelector(".btn-del-reading");
      delBtn?.addEventListener("click", async (e) => {
        e.stopPropagation();
        if (confirm("确定要彻底删除这条精读记录吗？")) {
          await handleDeleteReading(item.id);
        }
      });
    }

    // 绑定标签筛选点击
    card.querySelectorAll(".reading-tag-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const tag = btn.getAttribute("data-tag");
        if (tag) {
          setReadingTagFilter(currentTagFilter === tag ? null : tag);
        }
      });
    });

    return card;
  }

  // 加载列表数据
  async function loadReadings(page = 0, isAppend = false) {
    if (isLoading) return;
    isLoading = true;

    if (!isAppend) {
      currentPage = 0;
      skeleton?.classList.remove("hidden");
      if (listContainer) listContainer.innerHTML = "";
      emptyState?.classList.add("hidden");
      pagination?.classList.add("hidden");
    }

    try {
      const from = page * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;

      let query = supabase
        .from("daily_readings")
        .select("*", { count: "exact" })
        .order("created_at", { ascending: false });

      if (!isAuthor) {
        query = query.eq("is_private", false);
      }

      if (currentTagFilter) {
        query = query.contains("tags", [currentTagFilter]);
      }

      const { data, count, error } = await query.range(from, to);

      skeleton?.classList.add("hidden");

      if (error) {
        if (error.code === "42P01" || error.message?.includes("does not exist")) {
          setupTip?.classList.remove("hidden");
        }
        emptyState?.classList.remove("hidden");
        return;
      }

      totalCount = count || 0;
      if (countBadge) {
        countBadge.textContent = String(totalCount);
        countBadge.classList.toggle("hidden", totalCount === 0);
      }

      const items: ReadingItem[] = data || [];

      if (!isAppend && items.length === 0) {
        emptyState?.classList.remove("hidden");
        return;
      }

      if (listContainer) {
        items.forEach((item) => {
          listContainer.appendChild(renderReadingCard(item));
        });
      }

      hasMore = (page + 1) * PAGE_SIZE < totalCount && items.length > 0;
      currentPage = page;

      if (pagination) {
        pagination.classList.toggle("hidden", !hasMore);
      }
    } catch (err) {
      console.error("加载 Readings 失败:", err);
      skeleton?.classList.add("hidden");
      emptyState?.classList.remove("hidden");
    } finally {
      isLoading = false;
    }
  }

  // 加载全站 Readings 专属技术标签 (从统一 daily_tags 表中按 type = 'reading' 读取)
  async function loadAllReadingTags() {
    try {
      const readingSet = new Set<string>();
      const usage: Record<string, number> = {};

      // 1. 从统一标签表 daily_tags 中精确读取 type = 'reading' 的标签记录
      try {
        const { data: tagRows } = await supabase
          .from("daily_tags")
          .select("name")
          .eq("type", "reading")
          .order("name", { ascending: true });
        if (tagRows) {
          tagRows.forEach((r: any) => {
            const clean = String(r?.name || "").replace(/^#/, "").trim();
            if (clean) readingSet.add(clean);
          });
        }
      } catch (e) {
        console.warn("读取 daily_tags(type=reading) 提示:", e);
      }

      // 2. 从 daily_readings 中统计各技术标签的实际使用篇数（非博主仅统计公开精读）
      try {
        let tagSourceQuery = supabase.from("daily_readings").select("tags");
        if (!isAuthor) {
          tagSourceQuery = tagSourceQuery.eq("is_private", false);
        }
        const { data: readingsData } = await tagSourceQuery;
        if (readingsData) {
          readingsData.forEach((row: any) => {
            if (Array.isArray(row?.tags)) {
              row.tags.forEach((t: string) => {
                const clean = String(t).replace(/^#/, "").trim();
                if (clean) {
                  readingSet.add(clean);
                  usage[clean] = (usage[clean] || 0) + 1;
                }
              });
            }
          });
        }
      } catch (e) {}

      tagUsageMap = usage;
      allReadingTags = Array.from(readingSet).sort((a, b) => a.localeCompare(b, "zh-CN"));
      // 顶部筛选栏仅展示至少被 1 篇精读使用的标签
      activeFilterTags = allReadingTags.filter((t) => (usage[t] || 0) > 0);

      renderFilterBar();
      renderSuggestedTags();
    } catch (err) {
      console.warn("加载标签库异常:", err);
    }
  }

  // 渲染顶部标签筛选栏
  function renderFilterBar() {
    if (!filterBar || !filterList) return;
    if (activeFilterTags.length === 0) {
      filterBar.classList.add("hidden");
      filterList.innerHTML = "";
      return;
    }

    filterBar.classList.remove("hidden");
    filterList.innerHTML = "";

    // 活跃态更新
    if (filterAllBtn) {
      if (!currentTagFilter) {
        filterAllBtn.className = "inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-900 text-white transition-colors cursor-pointer";
      } else {
        filterAllBtn.className = "inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-100 hover:bg-neutral-200 text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer";
      }
    }

    activeFilterTags.forEach((tag) => {
      const btn = document.createElement("button");
      btn.type = "button";
      const isActive = currentTagFilter === tag;
      const count = tagUsageMap[tag] || 0;
      btn.className = `inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm cursor-pointer select-none transition-colors ${
        isActive
          ? "bg-neutral-900 text-white"
          : "bg-neutral-100 hover:bg-neutral-200 text-neutral-600 hover:text-neutral-900"
      }`;
      btn.textContent = count > 1 ? `#${tag} (${count})` : `#${tag}`;
      btn.title = `筛选标签 #${tag} (${count}篇)`;
      btn.addEventListener("click", () => {
        setReadingTagFilter(isActive ? null : tag);
      });
      filterList.appendChild(btn);
    });
  }

  function setReadingTagFilter(tag: string | null) {
    currentTagFilter = tag;
    renderFilterBar();
    loadReadings(0, false);
  }

  // ===== 精读技术标签管理 (Modal) =====
  async function openTagManagerModal() {
    if (!isAuthor || !tagManagerModal) return;
    tagManagerModal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    if (tagManagerNewInput) tagManagerNewInput.value = "";
    await refreshTagManagerData();
  }

  function closeTagManagerModal() {
    if (!tagManagerModal) return;
    tagManagerModal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  async function refreshTagManagerData() {
    if (!tagManagerList) return;
    tagManagerList.innerHTML = '<div class="text-center py-4 text-neutral-400 text-xs"><i class="ph ph-spinner animate-spin text-sm mr-1"></i>加载技术标签...</div>';

    await loadAllReadingTags();
    renderTagManagerList();
  }

  function renderTagManagerList() {
    if (!tagManagerList) return;
    if (tagManagerTotalCount) {
      tagManagerTotalCount.textContent = `共 ${allReadingTags.length} 个技术标签`;
    }

    if (allReadingTags.length === 0) {
      tagManagerList.innerHTML = '<div class="text-center py-6 text-neutral-400 text-xs">当前还没有任何技术标签，可在上方输入新建</div>';
      return;
    }

    tagManagerList.innerHTML = "";
    allReadingTags.forEach((tag) => {
      const count = tagUsageMap[tag] || 0;
      const row = document.createElement("div");
      row.className = "flex items-center justify-between p-1.5 rounded hover:bg-neutral-50 transition-colors group";
      row.setAttribute("data-tag-row", tag);

      row.innerHTML = `
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="font-medium text-neutral-800 text-xs truncate">#${tag}</span>
          <span class="text-[10px] text-neutral-400 shrink-0">(${count} 篇精读)</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button type="button" class="btn-rename text-neutral-400 hover:text-neutral-800 p-1 rounded hover:bg-neutral-200/50 cursor-pointer" title="重命名">
            <i class="ph ph-pencil-simple text-xs"></i>
          </button>
          <button type="button" class="btn-delete text-neutral-400 hover:text-red-600 p-1 rounded hover:bg-red-50 cursor-pointer" title="删除">
            <i class="ph ph-trash text-xs"></i>
          </button>
        </div>
      `;

      const renameBtn = row.querySelector(".btn-rename");
      const deleteBtn = row.querySelector(".btn-delete");

      renameBtn?.addEventListener("click", () => {
        row.innerHTML = `
          <div class="flex items-center gap-1.5 grow mr-2">
            <input type="text" class="rename-input grow bg-neutral-50 border border-neutral-300 rounded px-1.5 py-0.5 text-xs text-neutral-800 focus:outline-none focus:border-neutral-800" value="${tag}" />
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" class="btn-save-rename text-xs text-neutral-900 bg-neutral-200 hover:bg-neutral-300 px-2 py-0.5 rounded cursor-pointer">保存</button>
            <button type="button" class="btn-cancel-rename text-xs text-neutral-500 hover:text-neutral-800 px-1 py-0.5 cursor-pointer">取消</button>
          </div>
        `;
        const renameInput = row.querySelector(".rename-input") as HTMLInputElement | null;
        const saveBtn = row.querySelector(".btn-save-rename");
        const cancelBtn = row.querySelector(".btn-cancel-rename");

        renameInput?.focus();
        renameInput?.select();

        const doSave = async () => {
          const newName = renameInput?.value.replace(/^#/, "").trim() || "";
          if (!newName || newName === tag) {
            renderTagManagerList();
            return;
          }
          await handleRenameTag(tag, newName);
        };

        saveBtn?.addEventListener("click", doSave);
        renameInput?.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            doSave();
          } else if (e.key === "Escape") {
            renderTagManagerList();
          }
        });
        cancelBtn?.addEventListener("click", () => renderTagManagerList());
      });

      deleteBtn?.addEventListener("click", () => {
        handleDeleteTag(tag, count);
      });

      tagManagerList.appendChild(row);
    });
  }

  // 重命名技术标签（级联更新 daily_tags 表与所有相关 daily_readings）
  async function handleRenameTag(oldName: string, newName: string) {
    try {
      // 1. 更新 daily_tags 表 (限定 type = 'reading')
      const { error: tagError } = await supabase
        .from("daily_tags")
        .update({ name: newName })
        .eq("name", oldName)
        .eq("type", "reading");
      if (tagError) console.warn("更新 daily_tags 提示:", tagError);

      // 2. 查询并级联更新所有包含 oldName 的精读笔记
      const { data: affectedReadings } = await supabase
        .from("daily_readings")
        .select("id, tags")
        .contains("tags", [oldName]);

      if (affectedReadings && affectedReadings.length > 0) {
        for (const r of affectedReadings) {
          const updatedTags = Array.from(
            new Set((r.tags || []).map((t: string) => (t.replace(/^#/, "").trim() === oldName ? newName : t.replace(/^#/, "").trim())))
          );
          await supabase.from("daily_readings").update({ tags: updatedTags }).eq("id", r.id);
        }
      }

      if (currentTagFilter === oldName) {
        currentTagFilter = newName;
      }

      await loadAllReadingTags();
      await loadReadings(0, false);
      await refreshTagManagerData();
    } catch (err: any) {
      console.error("重命名技术标签失败:", err);
      alert(`重命名失败: ${err.message || "请检查网络或 Supabase 权限"}`);
    }
  }

  // 删除技术标签（级联从 daily_tags 删除，并从所有 daily_readings 中剔除）
  async function handleDeleteTag(tagName: string, count: number) {
    const message = count > 0
      ? `确定要删除技术标签 #${tagName} 吗？当前有 ${count} 篇精读笔记正在使用该标签，删除后将同时从这些笔记中移除此标签。`
      : `确定要删除技术标签 #${tagName} 吗？该标签当前未被任何精读笔记使用。`;

    if (!confirm(message)) return;

    try {
      // 1. 从 daily_tags 表中删除 (限定 type = 'reading')
      const { error: tagDelErr } = await supabase
        .from("daily_tags")
        .delete()
        .eq("name", tagName)
        .eq("type", "reading");
      if (tagDelErr) console.warn("从 daily_tags 删除技术标签提示:", tagDelErr);

      // 2. 查询并级联从所有精读笔记中移除 tagName
      const { data: affectedReadings } = await supabase
        .from("daily_readings")
        .select("id, tags")
        .contains("tags", [tagName]);

      if (affectedReadings && affectedReadings.length > 0) {
        for (const r of affectedReadings) {
          const updatedTags = (r.tags || []).filter((t: string) => t.replace(/^#/, "").trim() !== tagName);
          await supabase.from("daily_readings").update({ tags: updatedTags }).eq("id", r.id);
        }
      }

      if (currentTagFilter === tagName) {
        currentTagFilter = null;
      }

      await loadAllReadingTags();
      await loadReadings(0, false);
      await refreshTagManagerData();
    } catch (err: any) {
      console.error("删除技术标签失败:", err);
      alert(`删除标签失败: ${err.message || "请检查网络或权限"}`);
    }
  }

  // 在标签管理器中新建技术标签
  async function handleAddNewTagInManager() {
    if (!tagManagerNewInput) return;
    const clean = tagManagerNewInput.value.replace(/^#/, "").trim();
    if (!clean) return;

    if (allReadingTags.includes(clean)) {
      alert(`技术标签 #${clean} 已存在！`);
      return;
    }

    try {
      const { error } = await supabase.from("daily_tags").insert([{ name: clean, type: "reading" }]);
      if (error) throw error;

      tagManagerNewInput.value = "";
      await loadAllReadingTags();
      await refreshTagManagerData();
    } catch (err: any) {
      console.error("新建技术标签失败:", err);
      alert(`新建标签失败: ${err.message || "请检查权限"}`);
    }
  }

  // 打开编辑精读记录
  function openEditReading(item: ReadingItem) {
    if (!isAuthor) return;
    editingReadingId = item.id;

    if (inputUrl) inputUrl.value = item.url || "";
    if (inputTitle) inputTitle.value = item.title || "";
    if (inputSource) inputSource.value = item.source || "";
    if (inputSummary) inputSummary.value = item.summary || "";
    if (inputPrivate) inputPrivate.checked = Boolean(item.is_private);
    draftTags = (item.tags || []).map((t) => t.replace(/^#/, "").trim()).filter(Boolean);

    renderDraftTags();
    renderSuggestedTags();

    if (composerTitle) {
      composerTitle.innerHTML = `编辑阅读笔记 <span class="text-[11px] font-mono text-neutral-400 font-normal">(编辑中)</span>`;
    }
    if (composerSubtitle) {
      composerSubtitle.textContent = "修改文章原文链接、标题、思考总结与技术标签";
    }
    if (submitText) {
      submitText.textContent = "保存修改";
    }

    composer?.classList.remove("hidden");
    composer?.scrollIntoView({ behavior: "smooth", block: "start" });
    inputSummary?.focus();
  }

  // 重置发布/编辑表单状态
  function resetComposerState() {
    editingReadingId = null;
    if (inputUrl) inputUrl.value = "";
    if (inputTitle) inputTitle.value = "";
    if (inputSource) inputSource.value = "";
    if (inputSummary) inputSummary.value = "";
    if (inputTag) inputTag.value = "";
    if (inputPrivate) inputPrivate.checked = false;
    draftTags = [];
    renderDraftTags();
    renderSuggestedTags();

    if (composerTitle) {
      composerTitle.textContent = "记录阅读笔记";
    }
    if (composerSubtitle) {
      composerSubtitle.textContent = "支持手机快速粘贴 URL 与要点思考";
    }
    if (submitText) {
      submitText.textContent = "发布记录";
    }
  }

  // 提交发布或保存修改
  async function handleSaveReading() {
    if (!isAuthor || !currentUser) {
      alert("仅博主可操作精读记录。");
      return;
    }

    const url = inputUrl?.value.trim();
    const title = inputTitle?.value.trim();
    const source = inputSource?.value.trim();
    const summary = inputSummary?.value.trim();

    if (!url) {
      alert("请填写原文链接 (URL)");
      inputUrl?.focus();
      return;
    }

    if (!title) {
      alert("请填写阅读的文章原标题");
      inputTitle?.focus();
      return;
    }

    if (!summary) {
      alert("请填写笔记与思考内容 (Notes)");
      inputSummary?.focus();
      return;
    }

    if (submitBtn) submitBtn.setAttribute("disabled", "true");
    submitSpinner?.classList.remove("hidden");
    const isEdit = Boolean(editingReadingId);
    if (submitText) submitText.textContent = isEdit ? "保存中..." : "发布中...";

    try {
      const ghUsername = currentUser.user_metadata?.user_name || AUTHOR_GITHUB;
      const payload = {
        title,
        url,
        source: source || getHostname(url),
        summary,
        tags: draftTags,
        is_private: Boolean(inputPrivate?.checked),
        author_github: ghUsername,
      };

      if (isEdit && editingReadingId) {
        // 编辑更新
        const { error } = await supabase
          .from("daily_readings")
          .update(payload)
          .eq("id", editingReadingId);
        if (error) throw error;
      } else {
        // 新建插入
        const { error } = await supabase
          .from("daily_readings")
          .insert([payload]);
        if (error) throw error;
      }

      // 将新增技术标签同步至统一标签表 daily_tags，标记 type = 'reading'
      draftTags.forEach((t) => {
        try {
          supabase.from("daily_tags").upsert([{ name: t, type: "reading" }], { onConflict: "name,type" }).then();
        } catch (e) {
          try {
            supabase.from("daily_tags").insert([{ name: t, type: "reading" }]).then();
          } catch (err) {}
        }
      });

      // 清空表单并收起
      resetComposerState();
      composer?.classList.add("hidden");

      // 重新加载标签池与列表
      await loadAllReadingTags();
      await loadReadings(0, false);
    } catch (err: any) {
      console.error(isEdit ? "更新精读失败:" : "发布精读失败:", err);
      alert(`${isEdit ? "保存" : "发布"}失败: ${err.message || "请检查网络或 Supabase 权限"}`);
    } finally {
      if (submitBtn) submitBtn.removeAttribute("disabled");
      submitSpinner?.classList.add("hidden");
      if (submitText) submitText.textContent = isEdit ? "保存修改" : "发布记录";
    }
  }

  // 切换某条精读记录的隐私可见性 (公开 <-> 仅我可见)
  async function handleToggleReadingPrivacy(
    item: ReadingItem,
    newPrivateState: boolean,
    btn?: HTMLButtonElement | null,
    badgeEl?: HTMLElement | null
  ) {
    try {
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="ph ph-spinner animate-spin text-xs"></i>';
      }

      const { error } = await supabase
        .from("daily_readings")
        .update({ is_private: newPrivateState })
        .eq("id", item.id)
        .select();

      if (error) throw error;

      item.is_private = newPrivateState;

      if (badgeEl) {
        badgeEl.classList.toggle("hidden", !newPrivateState);
      }
      if (btn) {
        btn.disabled = false;
        btn.className = `btn-privacy-reading ${
          newPrivateState
            ? "text-neutral-700 hover:text-neutral-900"
            : "text-neutral-350 hover:text-neutral-700"
        } p-1 rounded hover:bg-neutral-100 cursor-pointer transition-colors flex items-center justify-center`;
        btn.title = newPrivateState ? "当前状态：仅我可见（点击公开）" : "当前状态：公开（点击设为仅我可见）";
        btn.innerHTML = newPrivateState ? closedEyeSvg : '<i class="ph ph-eye text-sm"></i>';
      }
    } catch (err: any) {
      console.error("切换精读可见性失败:", err);
      alert(`更新可见性失败: ${err.message || "请检查网络或 Supabase 权限/字段"}`);
      if (btn) {
        btn.disabled = false;
        const currentPriv = Boolean(item.is_private);
        btn.innerHTML = currentPriv ? closedEyeSvg : '<i class="ph ph-eye text-sm"></i>';
      }
    }
  }

  // 删除某条记录
  async function handleDeleteReading(id: string) {
    try {
      const { error } = await supabase.from("daily_readings").delete().eq("id", id);
      if (error) throw error;

      const card = document.getElementById(`reading-${id}`);
      if (card) {
        card.style.opacity = "0";
        card.style.transform = "scale(0.97)";
        setTimeout(() => {
          card.remove();
          totalCount = Math.max(0, totalCount - 1);
          if (countBadge) {
            countBadge.textContent = String(totalCount);
            countBadge.classList.toggle("hidden", totalCount === 0);
          }
          if (listContainer && listContainer.children.length === 0) {
            emptyState?.classList.remove("hidden");
          }
        }, 200);
      }

      // 重新计算标签计数
      await loadAllReadingTags();
    } catch (err: any) {
      console.error("删除失败:", err);
      alert(`删除失败: ${err.message || "网络异常"}`);
    }
  }

  // 处理认证状态更新
  function handleAuthState(user: any) {
    currentUser = user;
    if (user) {
      const ghUsername = user.user_metadata?.user_name || user.email?.split("@")[0] || "";
      isAuthor = ghUsername.toLowerCase() === AUTHOR_GITHUB.toLowerCase();

      if (isAuthor) {
        if (userPanel) {
          userPanel.style.display = "flex";
          userPanel.classList.remove("hidden");
          userPanel.classList.add("flex");
        }
        if (toggleComposeBtn) {
          toggleComposeBtn.style.display = "inline-flex";
          toggleComposeBtn.classList.remove("hidden");
          toggleComposeBtn.classList.add("inline-flex");
        }
        if (openTagManagerBtn) {
          openTagManagerBtn.style.display = "flex";
          openTagManagerBtn.classList.remove("hidden");
          openTagManagerBtn.classList.add("flex");
        }
      } else {
        if (userPanel) {
          userPanel.style.display = "none";
          userPanel.classList.add("hidden");
          userPanel.classList.remove("flex");
        }
        if (toggleComposeBtn) {
          toggleComposeBtn.style.display = "none";
          toggleComposeBtn.classList.add("hidden");
        }
        if (openTagManagerBtn) {
          openTagManagerBtn.style.display = "none";
          openTagManagerBtn.classList.add("hidden");
        }
      }
    } else {
      isAuthor = false;

      if (userPanel) {
        userPanel.style.display = "none";
        userPanel.classList.add("hidden");
        userPanel.classList.remove("flex");
      }

      if (toggleComposeBtn) {
        toggleComposeBtn.style.display = "none";
        toggleComposeBtn.classList.add("hidden");
      }
      if (openTagManagerBtn) {
        openTagManagerBtn.style.display = "none";
        openTagManagerBtn.classList.add("hidden");
      }
      composer?.classList.add("hidden");
    }

    // 重新加载全量标签与列表（同步博主操作权限）
    loadAllReadingTags();
    loadReadings(0, false);
  }

  // 事件监听绑定

  toggleComposeBtn?.addEventListener("click", () => {
    if (editingReadingId) {
      resetComposerState();
      composer?.classList.remove("hidden");
      inputUrl?.focus();
      return;
    }
    composer?.classList.toggle("hidden");
    if (composer && !composer.classList.contains("hidden")) {
      inputUrl?.focus();
      renderDraftTags();
      renderSuggestedTags();
    }
  });

  cancelComposeBtn?.addEventListener("click", () => {
    resetComposerState();
    composer?.classList.add("hidden");
  });

  submitBtn?.addEventListener("click", handleSaveReading);

  quickSourceBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const src = btn.getAttribute("data-source");
      if (inputSource && src) {
        inputSource.value = src;
      }
    });
  });

  filterAllBtn?.addEventListener("click", () => {
    setReadingTagFilter(null);
  });

  loadMoreBtn?.addEventListener("click", () => {
    if (hasMore && !isLoading) {
      loadReadings(currentPage + 1, true);
    }
  });

  // 确保弹窗挂载在 body 上避免被容器 overflow 裁剪
  if (typeof document !== "undefined" && tagManagerModal && tagManagerModal.parentElement !== document.body) {
    document.body.appendChild(tagManagerModal);
  }

  // 标签管理器事件绑定
  openTagManagerBtn?.addEventListener("click", openTagManagerModal);
  tagManagerCloseBtn?.addEventListener("click", closeTagManagerModal);
  tagManagerCloseIconBtn?.addEventListener("click", closeTagManagerModal);
  tagManagerModal?.addEventListener("click", (e) => {
    if (e.target === tagManagerModal) closeTagManagerModal();
  });
  tagManagerAddBtn?.addEventListener("click", handleAddNewTagInManager);
  tagManagerNewInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      handleAddNewTagInManager();
    }
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && tagManagerModal && !tagManagerModal.classList.contains("hidden")) {
      closeTagManagerModal();
    }
  });

  // 认证状态监听（复用 Supabase 会话）
  supabase.auth.onAuthStateChange((_event, session) => {
    handleAuthState(session?.user || null);
  });
</script>
