---
// src/components/Mermaid.astro
// Mermaid 客户端渲染组件：按需动态加载 Mermaid 并将 Markdown 中的 Mermaid 代码块渲染为 SVG 矢量图
---

<script>
    async function initMermaid() {
        const preElements = Array.from(document.querySelectorAll("pre"));
        const mermaidBlocks = preElements.filter((pre) => {
            const codeEl = pre.querySelector("code");
            const dataLang = pre.getAttribute("data-language") || codeEl?.getAttribute("class") || "";
            const text = (codeEl ? codeEl.textContent : pre.textContent) || "";

            return (
                dataLang.includes("mermaid") ||
                /^\s*(sequenceDiagram|flowchart|graph|classDiagram|stateDiagram|erDiagram|gantt|pie|journey|gitGraph|mindmap|timeline)/m.test(text)
            );
        });

        if (mermaidBlocks.length === 0) return;

        try {
            // @ts-ignore 按需动态引入 Mermaid ESM 模块
            const { default: mermaid } = await import(
                "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
            );

            mermaid.initialize({
                startOnLoad: false,
                theme: "neutral",
                fontFamily: "'JetBrains Mono', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                securityLevel: "loose",
            });

            for (let i = 0; i < mermaidBlocks.length; i++) {
                const pre = mermaidBlocks[i];
                const code = (pre.querySelector("code")?.textContent || pre.textContent || "").trim();

                const container = document.createElement("div");
                container.className =
                    "mermaid-diagram my-8 flex justify-center items-center overflow-x-auto p-6 bg-white border border-neutral-200 rounded-lg shadow-xs";

                const renderId = `mermaid-svg-${Date.now()}-${i}`;
                try {
                    const { svg } = await mermaid.render(renderId, code);
                    container.innerHTML = svg;
                    pre.replaceWith(container);
                } catch (error) {
                    console.error("Failed to render mermaid diagram:", error);
                }
            }
        } catch (e) {
            console.error("Mermaid loading error:", e);
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMermaid);
    } else {
        initMermaid();
    }
</script>
