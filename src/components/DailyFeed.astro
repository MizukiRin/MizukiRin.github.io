---
// src/components/DailyFeed.astro
import { siteConfig } from "../config";
import { formatDate } from "../utils/date";

interface Props {
  archivePosts?: any[];
}

const { archivePosts = [] } = Astro.props;
---

<div id="daily-feed-container" class="space-y-6">
  <!-- 顶部状态栏与操作栏 -->
  <div class="flex flex-wrap items-center justify-between gap-y-2 border-b border-neutral-100 pb-3">
    <div class="flex items-center space-x-2">
      <span class="text-xs font-mono uppercase tracking-wider text-neutral-400">Timeline / Memos</span>
      <span id="daily-count-badge" class="hidden text-[11px] font-mono bg-neutral-100 text-neutral-600 px-1.5 py-0.5 rounded">0</span>
    </div>

    <!-- 用户身份与登录状态 -->
    <div id="daily-auth-section" class="flex items-center space-x-2.5 text-xs font-mono">
      <!-- 未登录状态：简约的 GitHub 登录按钮 -->
      <button
        id="github-login-btn"
        class="inline-flex items-center space-x-1.5 text-neutral-500 hover:text-neutral-900 border border-neutral-200 hover:border-neutral-400 bg-white px-2.5 py-1 rounded transition-all shadow-xs cursor-pointer"
        title="使用 GitHub 登录以发布动态"
      >
        <i class="ph ph-github-logo text-sm"></i>
        <span>GitHub 登录</span>
      </button>

      <!-- 已登录状态 (默认隐藏，登录后显示作者信息与发帖/退出按钮) -->
      <div id="daily-user-panel" class="hidden items-center space-x-2 sm:space-x-3">
        <div class="flex items-center space-x-1.5">
          <img id="user-avatar" src="" alt="avatar" class="w-5 h-5 rounded-full border border-neutral-200" />
          <span id="user-name" class="text-neutral-800 font-medium max-w-[80px] sm:max-w-none truncate"></span>
        </div>

        <!-- 发动态按钮：移动端纯方形小胶囊图标且完美水平垂直居中，桌面端带完整文字 -->
        <button
          id="toggle-compose-btn"
          class="hidden w-7 h-7 sm:w-auto sm:h-auto flex items-center justify-center sm:space-x-1 bg-neutral-900 hover:bg-neutral-800 text-white rounded sm:px-2.5 sm:py-1 transition-colors shadow-xs cursor-pointer whitespace-nowrap select-none"
          title="发动态"
        >
          <i class="ph ph-note-pencil text-sm flex items-center justify-center"></i>
          <span class="hidden sm:inline">发动态</span>
        </button>

        <!-- 标签管理按钮：账号旁的专属方形小图标按钮，仅博主可见 -->
        <button
          id="open-tag-manager-btn"
          class="hidden w-7 h-7 flex items-center justify-center text-neutral-400 hover:text-neutral-900 rounded hover:bg-neutral-100 transition-colors cursor-pointer select-none"
          title="标签管理"
        >
          <i class="ph ph-tag text-sm"></i>
        </button>

        <button
          id="logout-btn"
          class="w-7 h-7 flex items-center justify-center text-neutral-400 hover:text-red-600 rounded hover:bg-neutral-100 transition-colors cursor-pointer"
          title="退出登录"
        >
          <i class="ph ph-sign-out text-sm"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- 发帖卡片 (默认隐藏，仅博主登录后可展开) -->
  <div id="daily-composer" class="hidden bg-white border border-neutral-200 rounded-sm p-3.5 sm:p-4 space-y-3 shadow-xs animate-fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs text-neutral-400 font-mono gap-1">
      <span class="font-medium text-neutral-600">发布新随想</span>
      <span class="text-[11px] text-neutral-400">支持 Markdown · 支持截图 Ctrl+V 粘贴</span>
    </div>

    <!-- 文本输入框 -->
    <textarea
      id="daily-content-input"
      rows="3"
      placeholder="记录这一刻的想法、随想或日常碎片..."
      class="w-full text-sm text-neutral-800 placeholder:text-neutral-300 border border-neutral-200 rounded-sm p-3 focus:outline-none focus:border-neutral-400 transition-colors resize-y font-sans leading-relaxed"
    ></textarea>

    <!-- 待上传图片预览列表 -->
    <div id="image-preview-list" class="hidden grid grid-cols-3 sm:grid-cols-4 gap-2 pt-1">
      <!-- 预览项由 JS 动态生成 -->
    </div>

    <!-- 工具栏与操作按钮 (针对手机小屏结构分层排版，彻底解决错行挤压) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-2 border-t border-neutral-100">
      <!-- 工具输入区 -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <!-- 上传图片按钮 -->
        <label
          for="image-file-input"
          class="inline-flex items-center space-x-1 text-xs text-neutral-600 hover:text-neutral-900 cursor-pointer px-2 py-1 border border-dashed border-neutral-200 hover:border-neutral-400 rounded transition-colors whitespace-nowrap"
        >
          <i class="ph ph-image text-sm"></i>
          <span>图片</span>
        </label>
        <input
          type="file"
          id="image-file-input"
          accept="image/*"
          multiple
          class="hidden"
        />

        <!-- 标签选择器与已选标签预览 -->
        <div class="relative flex items-center gap-1.5 flex-wrap" id="composer-tags-container">
          <!-- 已选标签胶囊容器 -->
          <div id="composer-selected-tags" class="flex items-center gap-1 flex-wrap"></div>

          <!-- 添加标签按钮与下拉弹层 -->
          <div class="relative" id="tag-picker-container">
            <button
              type="button"
              id="open-tag-picker-btn"
              class="inline-flex items-center space-x-1 text-xs text-neutral-600 hover:text-neutral-900 cursor-pointer px-2 py-1 border border-dashed border-neutral-200 hover:border-neutral-400 rounded transition-colors whitespace-nowrap select-none"
              title="选择或新建标签"
            >
              <i class="ph ph-tag text-xs"></i>
              <span>+ 标签</span>
            </button>

            <!-- 标签选择浮层弹窗 (浮在工具栏上方) -->
            <div
              id="tag-picker-popover"
              class="hidden absolute left-0 bottom-full mb-1.5 z-30 w-56 sm:w-64 bg-white border border-neutral-200/90 rounded-sm shadow-xl p-2.5 space-y-2 font-mono text-xs animate-scale-in"
            >
              <div class="flex items-center justify-between pb-1 border-b border-neutral-100 text-[11px] text-neutral-400">
                <span>选择已有或新建</span>
                <button id="close-tag-picker-btn" type="button" class="text-neutral-400 hover:text-neutral-700 cursor-pointer p-0.5">
                  <i class="ph ph-x"></i>
                </button>
              </div>

              <!-- 搜索或新建输入框 -->
              <input
                id="tag-picker-input"
                type="text"
                placeholder="搜索已有，或按 Enter 新建..."
                class="w-full bg-neutral-50 border border-neutral-200 rounded px-2 py-1 text-xs text-neutral-800 placeholder:text-neutral-400 focus:outline-none focus:border-neutral-400"
              />

              <!-- 新建标签快捷按钮 -->
              <button
                id="tag-picker-create-btn"
                type="button"
                class="hidden w-full text-left px-2 py-1 rounded bg-neutral-50 hover:bg-neutral-100 text-neutral-800 text-xs border border-neutral-200 border-dashed cursor-pointer transition-colors truncate"
              >
                <i class="ph ph-plus text-xs mr-1 text-neutral-500"></i>新建标签 "<span id="new-tag-name-preview"></span>"
              </button>

              <!-- 已有标签备选列表 -->
              <div class="space-y-1">
                <div class="text-[10px] text-neutral-400">已有标签：</div>
                <div id="tag-picker-options" class="max-h-28 overflow-y-auto flex flex-wrap gap-1 py-0.5">
                  <span class="text-[10px] text-neutral-300">暂无已有标签，可直接输入新建</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 仅我可见勾选 -->
        <label class="flex items-center space-x-1 text-xs font-mono text-neutral-500 hover:text-neutral-800 cursor-pointer select-none transition-colors ml-1" title="勾选后仅博主登录后可见，访客不可见">
          <input
            type="checkbox"
            id="daily-private-input"
            class="rounded border-neutral-300 text-neutral-900 focus:ring-0 w-3.5 h-3.5 cursor-pointer accent-neutral-900"
          />
          <span class="flex items-center space-x-1">
            <svg class="w-3.5 h-3.5 text-neutral-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10s3.5 6 10 6 10-6 10-6"/>
              <path d="M5 13.5L3 17"/>
              <path d="M9 16L8 20"/>
              <path d="M15 16L16 20"/>
              <path d="M19 13.5L21 17"/>
            </svg>
            <span>仅我可见</span>
          </span>
        </label>
      </div>

      <!-- 提交与取消按钮 -->
      <div class="flex items-center justify-end space-x-2 shrink-0">
        <button
          id="cancel-compose-btn"
          type="button"
          class="text-xs font-mono text-neutral-400 hover:text-neutral-600 px-2.5 py-1 cursor-pointer"
        >
          取消
        </button>
        <button
          id="submit-post-btn"
          type="button"
          class="inline-flex items-center space-x-1.5 bg-neutral-900 hover:bg-neutral-800 text-white text-xs font-mono px-3.5 py-1.5 rounded transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-xs cursor-pointer"
        >
          <i id="submit-spinner" class="ph ph-spinner animate-spin hidden"></i>
          <i id="submit-icon" class="ph ph-paper-plane-tilt"></i>
          <span id="submit-text">发布</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 时间轴骨架屏 (加载中状态) -->
  <div id="daily-skeleton" class="space-y-6 my-6">
    <div class="flex items-start animate-pulse">
      <div class="w-20 sm:w-28 shrink-0 text-right pr-3 sm:pr-5 pt-3.5 space-y-1.5">
        <div class="h-3 w-16 bg-neutral-200 rounded ml-auto"></div>
        <div class="h-3.5 w-8 bg-neutral-200 rounded ml-auto"></div>
      </div>
      <div class="relative flex flex-col items-center self-stretch shrink-0">
        <div class="w-[2px] bg-neutral-200/80 grow"></div>
        <div class="absolute top-4 w-3 h-3 rounded-full bg-neutral-300"></div>
      </div>
      <div class="flex-1 min-w-0 pl-3 sm:pl-6 pb-6">
        <div class="bg-white border border-neutral-100 p-4 sm:p-5 rounded-sm space-y-3">
          <div class="flex justify-between items-center pb-2 border-b border-neutral-100">
            <div class="h-4 w-20 bg-neutral-100 rounded"></div>
            <div class="h-3 w-28 bg-neutral-100 rounded"></div>
          </div>
          <div class="h-3 w-full bg-neutral-100 rounded"></div>
          <div class="h-3 w-3/4 bg-neutral-100 rounded"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 标签筛选栏 (有标签时展示，支持按标签过滤时间轴) -->
  <div id="daily-tag-filter-bar" class="hidden flex items-center gap-1.5 flex-wrap pt-3 pb-1 mb-2 font-mono text-xs select-none">
    <span class="text-neutral-400 mr-0.5 flex items-center text-[11px]">
      <i class="ph ph-funnel text-xs mr-1"></i>标签:
    </span>
    <button
      type="button"
      id="tag-filter-all-btn"
      class="tag-filter-pill active inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-900 text-white transition-colors cursor-pointer"
      data-tag="all"
    >
      全部
    </button>
    <div id="daily-tag-filter-list" class="flex items-center gap-1.5 flex-wrap">
      <!-- 动态渲染已有标签筛选按钮 -->
    </div>
  </div>

  <!-- 时间轴动态流容器 (左侧时间，中间轴线，右侧卡片) -->
  <div id="daily-posts-stream" class="my-6">
    <!-- 时间轴由 JS 渲染 -->
  </div>

  <!-- 分页加载区域与状态指示器 -->
  <div id="daily-pagination-container" class="hidden text-center py-6 select-none font-mono">
    <button
      id="daily-load-more-btn"
      type="button"
      class="inline-flex items-center space-x-1.5 text-xs text-neutral-500 hover:text-neutral-900 bg-white hover:bg-neutral-50 border border-neutral-200 hover:border-neutral-300 px-4 py-1.5 rounded transition-colors shadow-2xs cursor-pointer select-none"
    >
      <i id="daily-load-more-spinner" class="ph ph-spinner animate-spin hidden"></i>
      <i id="daily-load-more-icon" class="ph ph-arrow-down"></i>
      <span id="daily-load-more-text">加载更早动态</span>
    </button>
    <!-- 全部加载完毕提示 (与加载按钮互斥展示) -->
    <div id="daily-all-loaded-notice" class="hidden text-xs text-neutral-400 py-1">
      — 已加载全部动态 —
    </div>
  </div>

  <!-- 空状态提示 -->
  <div id="daily-empty-state" class="hidden text-center py-12 text-neutral-400 font-mono text-xs">
    <i class="ph ph-clock-counter-clockwise text-3xl mb-2 text-neutral-300"></i>
    <p>No daily notes yet.</p>
  </div>

  <!-- 往期长文/Markdown 归档折叠区 (若存在历史 Markdown 文章) -->
  {archivePosts.length > 0 && (
    <div class="pt-8 border-t border-neutral-200/60 mt-8">
      <details class="group">
        <summary class="cursor-pointer text-xs font-mono text-neutral-400 hover:text-neutral-800 flex items-center space-x-1.5 transition-colors select-none py-1">
          <i class="ph ph-caret-right transition-transform group-open:rotate-90"></i>
          <span>往期长文日记归档 ({archivePosts.length} 篇)</span>
        </summary>
        <div class="space-y-2 mt-3 pl-4 border-l border-neutral-200">
          {archivePosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group/item flex flex-col sm:flex-row sm:items-center justify-between py-2 border-b border-neutral-100 hover:bg-neutral-50 transition-colors -mx-2 px-2 rounded-sm"
            >
              <span class="text-neutral-800 text-sm group-hover/item:underline decoration-neutral-300 underline-offset-4">
                {post.data.title}
              </span>
              <span class="font-mono text-xs text-neutral-400 mt-0.5 sm:mt-0 shrink-0">
                {formatDate(post.data.date)}
              </span>
            </a>
          ))}
        </div>
      </details>
    </div>
  )}
</div>

<!-- 图片大图查看灯箱 (Lightbox Modal，支持多图左右切换与计数) -->
<div id="lightbox-modal" class="hidden fixed inset-0 z-[999] bg-black/90 backdrop-blur-xs flex items-center justify-center p-4 select-none">
  <!-- 关闭按钮 -->
  <button id="lightbox-close" class="absolute top-4 right-4 text-white/70 hover:text-white p-2 text-2xl transition-colors cursor-pointer z-20" title="关闭 (Esc)">
    <i class="ph ph-x"></i>
  </button>

  <!-- 图片计数器指示 (多图时展示，例如 "2 / 5") -->
  <div id="lightbox-counter" class="hidden absolute top-5 left-1/2 -translate-x-1/2 text-xs font-mono text-white/80 bg-neutral-900/80 px-3 py-1 rounded-full backdrop-blur-xs border border-white/10 z-20">
    <span id="lightbox-current-idx">1</span> / <span id="lightbox-total-idx">1</span>
  </div>

  <!-- 上一张按钮 (多图时展示) -->
  <button id="lightbox-prev" class="hidden absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 text-white/75 hover:text-white hover:bg-white/10 p-2 sm:p-3 rounded-full text-2xl sm:text-3xl transition-all cursor-pointer z-20" title="上一张 (←)">
    <i class="ph ph-caret-left"></i>
  </button>

  <!-- 下一张按钮 (多图时展示) -->
  <button id="lightbox-next" class="hidden absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 text-white/75 hover:text-white hover:bg-white/10 p-2 sm:p-3 rounded-full text-2xl sm:text-3xl transition-all cursor-pointer z-20" title="下一张 (→)">
    <i class="ph ph-caret-right"></i>
  </button>

  <!-- 放大图片展示主体 -->
  <div id="lightbox-stage" class="relative flex items-center justify-center w-full h-full max-w-5xl max-h-[88vh]">
    <img id="lightbox-img" src="" alt="Zoomed view" class="max-w-full max-h-[85vh] object-contain rounded shadow-2xl transition-transform duration-200" />
  </div>
</div>

<!-- 自定义确认模态框 (与博客极简设计风格保持一致：小圆角、柔和边框、黑白线条图标，z-index 提高到 1050 保证在任何其它模态框上方顶层呈现) -->
<div id="daily-confirm-modal" class="hidden fixed inset-0 z-[1050] bg-black/55 backdrop-blur-xs flex items-center justify-center p-4 transition-all">
  <div class="bg-neutral-50/95 border border-neutral-300/80 rounded-sm shadow-xl max-w-sm w-full p-5 sm:p-6 space-y-4 animate-scale-in">
    <div class="flex items-start space-x-3.5">
      <div id="modal-icon-container" class="w-8 h-8 flex items-center justify-center shrink-0 text-neutral-800">
        <i id="modal-icon" class="ph ph-trash text-xl"></i>
      </div>
      <div class="flex-1 min-w-0 pt-0.5">
        <h4 id="modal-title" class="text-sm font-semibold text-neutral-900 leading-snug">确认操作</h4>
        <p id="modal-message" class="text-xs text-neutral-500 mt-1.5 leading-relaxed">确定要继续执行此操作吗？</p>
      </div>
    </div>
    <div class="flex items-center justify-end space-x-2 pt-3 border-t border-neutral-200/70">
      <button
        id="modal-cancel-btn"
        type="button"
        class="text-xs font-mono text-neutral-500 hover:text-neutral-900 hover:bg-neutral-200/60 px-3 py-1.5 rounded-sm transition-colors cursor-pointer"
      >
        取消
      </button>
      <button
        id="modal-confirm-btn"
        type="button"
        class="inline-flex items-center space-x-1.5 text-xs font-mono bg-neutral-900 hover:bg-neutral-800 text-white px-3.5 py-1.5 rounded-sm transition-colors shadow-xs cursor-pointer border border-neutral-900"
      >
        <i id="modal-confirm-spinner" class="ph ph-spinner animate-spin hidden"></i>
        <span id="modal-confirm-text">确定删除</span>
      </button>
    </div>
  </div>
</div>

<!-- 标签管理模态弹窗 (仅博主可用：支持新建、改名、删除，并级联同步历史动态) -->
<div id="daily-tag-manager-modal" class="hidden fixed inset-0 z-[999] bg-black/45 backdrop-blur-xs flex items-center justify-center p-4 transition-all">
  <div class="bg-neutral-50/95 border border-neutral-300/80 rounded-sm shadow-xl max-w-md w-full p-5 sm:p-6 space-y-4 animate-scale-in font-mono text-xs">
    <!-- 头部 -->
    <div class="flex items-center justify-between pb-2 border-b border-neutral-200/80">
      <div class="flex items-center space-x-2">
        <i class="ph ph-tag text-base text-neutral-800"></i>
        <h4 class="text-sm font-semibold text-neutral-900">标签管理</h4>
      </div>
      <button id="tag-manager-close-icon-btn" type="button" class="text-neutral-400 hover:text-neutral-800 cursor-pointer p-1" title="关闭">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <!-- 顶部新建标签输入栏 -->
    <div class="flex items-center gap-2">
      <input
        id="tag-manager-new-input"
        type="text"
        placeholder="输入新标签名称..."
        class="grow bg-white border border-neutral-200 rounded px-2.5 py-1.5 text-xs text-neutral-800 placeholder:text-neutral-400 focus:outline-none focus:border-neutral-800 transition-colors"
      />
      <button
        id="tag-manager-add-btn"
        type="button"
        class="inline-flex items-center space-x-1 bg-neutral-900 hover:bg-neutral-800 text-white text-xs px-3 py-1.5 rounded transition-colors cursor-pointer select-none shrink-0"
      >
        <i class="ph ph-plus"></i>
        <span>新建</span>
      </button>
    </div>

    <!-- 标签列表区 (含使用统计与编辑/删除按钮) -->
    <div class="space-y-1">
      <div class="text-[11px] text-neutral-400 flex justify-between items-center px-1">
        <span>已有标签池</span>
        <span id="tag-manager-total-count" class="text-neutral-400">共 0 个标签</span>
      </div>
      <div id="tag-manager-list" class="max-h-64 overflow-y-auto space-y-1 pr-1 border border-neutral-200/60 rounded bg-white p-2">
        <!-- 标签项由 JS 动态生成 -->
      </div>
    </div>

    <!-- 底部操作与说明 -->
    <div class="flex items-center justify-between pt-2 border-t border-neutral-200/80 text-[11px] text-neutral-400">
      <span>修改或删除标签会同步更新关联的动态</span>
      <button
        id="tag-manager-close-btn"
        type="button"
        class="text-xs bg-neutral-100 hover:bg-neutral-200 text-neutral-800 px-3.5 py-1.5 rounded transition-colors cursor-pointer select-none"
      >
        完成
      </button>
    </div>
  </div>
</div>

<!-- 编辑单条动态标签模态弹窗 (仅博主：为已发布的某条动态添加/修改/移除标签) -->
<div id="daily-edit-post-tags-modal" class="hidden fixed inset-0 z-[999] bg-black/45 backdrop-blur-xs flex items-center justify-center p-4 transition-all">
  <div class="bg-neutral-50/95 border border-neutral-300/80 rounded-sm shadow-xl max-w-sm w-full p-5 space-y-3.5 animate-scale-in font-mono text-xs">
    <div class="flex items-center justify-between pb-2 border-b border-neutral-200/80">
      <div class="flex items-center space-x-1.5">
        <i class="ph ph-tag text-base text-neutral-800"></i>
        <h4 class="text-sm font-semibold text-neutral-900">编辑动态标签</h4>
      </div>
      <button id="edit-post-tags-close-icon-btn" type="button" class="text-neutral-400 hover:text-neutral-800 cursor-pointer p-0.5" title="关闭">
        <i class="ph ph-x text-sm"></i>
      </button>
    </div>

    <!-- 动态内容简略摘要 -->
