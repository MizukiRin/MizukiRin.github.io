  // 闭眼 SVG（弧形闭合眼线+睫毛）vs 睁眼图标（经典大眼睛）
  const closedEyeSvg = `
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 10s3.5 6 10 6 10-6 10-6"/>
      <path d="M5 13.5L3 17"/>
      <path d="M9 16L8 20"/>
      <path d="M15 16L16 20"/>
      <path d="M19 13.5L21 17"/>
    </svg>
  `;

  function showConfirmModal(options: {
    title: string;
    message: string;
    confirmText?: string;
    isDanger?: boolean;
  }): Promise<boolean> {
    return new Promise((resolve) => {
      confirmModalResolve = resolve;
      if (modalTitle) modalTitle.textContent = options.title;
      if (modalMessage) modalMessage.textContent = options.message;
      if (modalConfirmText) modalConfirmText.textContent = options.confirmText || "确定";

      if (modalConfirmBtn) {
        modalConfirmBtn.className = "inline-flex items-center space-x-1.5 text-xs font-mono bg-neutral-900 hover:bg-neutral-800 text-white px-3.5 py-1.5 rounded-sm transition-colors shadow-xs cursor-pointer border border-neutral-900";
      }
      if (modalIconContainer) {
        modalIconContainer.className = "w-8 h-8 flex items-center justify-center shrink-0 text-neutral-800";
      }
      if (modalIcon) {
        modalIcon.className = options.isDanger ? "ph ph-trash text-xl text-neutral-800" : "ph ph-lock text-xl text-neutral-800";
      }

      confirmModal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    });
  }

  function hideConfirmModal(result: boolean) {
    confirmModal?.classList.add("hidden");
    document.body.style.overflow = "";
    if (confirmModalResolve) {
      confirmModalResolve(result);
      confirmModalResolve = null;
    }
  }

  // 阻断删除弹窗出现时的滚轮与触摸滑动穿透到底层时间轴
  confirmModal?.addEventListener("wheel", (e) => e.preventDefault(), { passive: false });
  confirmModal?.addEventListener("touchmove", (e) => e.preventDefault(), { passive: false });

  modalCancelBtn?.addEventListener("click", () => hideConfirmModal(false));
  modalConfirmBtn?.addEventListener("click", () => hideConfirmModal(true));
  confirmModal?.addEventListener("click", (e) => {
    if (e.target === confirmModal) hideConfirmModal(false);
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && confirmModal && !confirmModal.classList.contains("hidden")) {
      hideConfirmModal(false);
    }
  });

  // 格式化时间戳：年月日 时分
  function formatFullDate(dateString: string): string {
    const d = new Date(dateString);
    const year = d.getFullYear();
    const month = String(d.getMonth() + 1).padStart(2, "0");
    const day = String(d.getDate()).padStart(2, "0");
    const hour = String(d.getHours()).padStart(2, "0");
    const min = String(d.getMinutes()).padStart(2, "0");
    return `${year}-${month}-${day} ${hour}:${min}`;
  }

  // 卡片时间格式化：6小时内显示相对时间（刚刚/X分钟前/X小时前），6小时前显示具体时间（YYYY-MM-DD HH:mm）
  function formatCardTime(dateString: string): { display: string; title: string } {
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffSec = Math.floor(diffMs / 1000);
    const diffMin = Math.floor(diffSec / 60);
    const diffHour = Math.floor(diffMin / 60);

    const fullStr = formatFullDate(dateString);

    if (diffMs < 0 || diffMin < 1) {
      return { display: "刚刚", title: fullStr };
    }
    if (diffMin < 60) {
      return { display: `${diffMin}分钟前`, title: fullStr };
    }
    if (diffHour < 6) {
      return { display: `${diffHour}小时前`, title: fullStr };
    }
    // 超过6小时，直接显示具体时间
    return { display: fullStr, title: fullStr };
  }

  // 内容转义与链接自动解析
  function escapeAndLinkify(text: string): string {
    const escaped = text
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
    return escaped.replace(
      /(https?:\/\/[^\s]+)/g,
      '<a href="$1" target="_blank" rel="noopener noreferrer" class="text-neutral-900 underline decoration-neutral-300 hover:decoration-neutral-900 underline-offset-2 break-all">$1</a>'
    );
  }

  // 渲染单条动态卡片内部的标签区域
  function renderPostTagsArea(tagsContainer: HTMLElement, post: PostItem) {
    tagsContainer.innerHTML = "";
    const hasTags = post.tags && post.tags.length > 0;
    if (hasTags) {
      post.tags!
        .filter((t) => t.trim().length > 0)
        .forEach((rawTag) => {
          const cleanTag = rawTag.replace(/^#/, "").trim();
          const tagBtn = document.createElement("button");
          tagBtn.type = "button";
          const isCurrentActive = currentTagFilter === cleanTag;
          tagBtn.className = isCurrentActive
            ? "text-[11px] font-mono text-white bg-neutral-900 border border-neutral-900 px-1.5 py-0.5 rounded cursor-pointer transition-colors select-none"
            : "text-[11px] font-mono text-neutral-500 hover:text-neutral-900 bg-neutral-50 hover:bg-neutral-100 border border-neutral-200/60 hover:border-neutral-300 px-1.5 py-0.5 rounded cursor-pointer transition-colors select-none";
          tagBtn.textContent = `#${cleanTag}`;
          tagBtn.title = `点击筛选标签 #${cleanTag}`;
          tagBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            setTagFilter(isCurrentActive ? null : cleanTag);
          });
          tagsContainer.appendChild(tagBtn);
        });
    }

    // 如果是博主，显示 [+ 添加标签] / [编辑标签] 快捷胶囊按钮
    if (isAuthor) {
      const editPostTagBtn = document.createElement("button");
      editPostTagBtn.type = "button";
      editPostTagBtn.className = "text-[11px] font-mono text-neutral-400 hover:text-neutral-800 bg-neutral-50/60 hover:bg-neutral-100 border border-dashed border-neutral-200 hover:border-neutral-400 px-1.5 py-0.5 rounded cursor-pointer transition-colors select-none inline-flex items-center gap-0.5";
      editPostTagBtn.innerHTML = hasTags
        ? '<i class="ph ph-tag-chevron text-[10px]"></i><span>编辑标签</span>'
        : '<i class="ph ph-plus text-[10px]"></i><span>添加标签</span>';
      editPostTagBtn.title = "为已发布的这条动态添加或修改标签";
      editPostTagBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        openEditPostTagsModal(post);
      });
      tagsContainer.appendChild(editPostTagBtn);
    }
  }

  // 渲染单个时间轴动态节点 (左侧：年月写在一起，下面写日；同一天多条默认只亮最新一条，点选或hover时当前条目日期高亮放大变深)
  function renderTimelineNode(post: PostItem, isFirstOfDay: boolean, comments: CommentItem[] = []): HTMLElement {
    const article = document.createElement("article");
    article.id = `post-${post.id}`;
    article.className = "timeline-article flex items-start group relative animate-fade-in";

    const postDate = new Date(post.created_at);
    const yearMonthStr = `${postDate.getFullYear()}.${String(postDate.getMonth() + 1).padStart(2, "0")}`;
    const dayNum = String(postDate.getDate()).padStart(2, "0");
    const cardTimeInfo = formatCardTime(post.created_at);

    // 1. 左侧：纯文字日期（手机端紧凑自适应 w-14/w-16，桌面端 w-28，防止挤占右侧空间）
    const leftCol = document.createElement("div");
    leftCol.className = "date-col w-14 sm:w-24 md:w-28 shrink-0 text-right pr-2 sm:pr-5 pt-3 select-none font-mono";
    leftCol.innerHTML = `
      <div class="text-[10px] sm:text-[11px] font-mono tracking-tight sm:tracking-wider text-neutral-400 group-hover:text-neutral-600 group-[.is-active]:text-neutral-900 group-[.is-active]:font-semibold transition-colors leading-none">
        ${yearMonthStr}
      </div>
      <div class="flex items-baseline justify-end mt-1.5 leading-none origin-right group-hover:scale-105 group-[.is-active]:scale-110 transition-transform duration-200">
        <span class="text-xl sm:text-3xl font-mono font-bold text-neutral-750 group-hover:text-neutral-950 group-[.is-active]:text-neutral-950 group-[.is-active]:font-extrabold transition-colors tracking-tight">
          ${dayNum}
        </span>
      </div>
    `;
    article.appendChild(leftCol);

    // 2. 中间：垂直连接线 + 时间轴圆点锚点
    const midCol = document.createElement("div");
    midCol.className = "relative flex flex-col items-center self-stretch shrink-0";
    midCol.innerHTML = `
      <div class="w-[2px] bg-neutral-200/90 grow group-[.is-active]:bg-neutral-400 transition-colors"></div>
      <div class="absolute top-4 w-3.5 h-3.5 rounded-full bg-white border-2 border-neutral-300 group-hover:border-neutral-900 group-hover:scale-125 group-[.is-active]:scale-125 group-[.is-active]:border-neutral-900 group-[.is-active]:bg-neutral-900 transition-all shadow-2xs flex items-center justify-center">
        <div class="w-1.5 h-1.5 rounded-full bg-neutral-400 group-hover:bg-neutral-900 group-[.is-active]:bg-white transition-colors"></div>
      </div>
    `;
    article.appendChild(midCol);

    // 3. 右侧：动态卡片主体
    const rightCol = document.createElement("div");
    rightCol.className = "flex-1 min-w-0 pl-2.5 sm:pl-6 pb-8";

    const card = document.createElement("div");
    card.className = "bg-white border border-neutral-200/90 rounded-sm p-3.5 sm:p-5 space-y-3 transition-all hover:border-neutral-400 hover:shadow-xs group-[.is-active]:border-neutral-900 group-[.is-active]:shadow-sm cursor-pointer";

    // 点选卡片激活高亮逻辑
    card.addEventListener("click", (e) => {
      // 避免点击卡片内部链接或删除按钮时触发
      if ((e.target as HTMLElement).closest("a, button, input, label")) return;
      const isActive = article.classList.contains("is-active");
      document.querySelectorAll(".timeline-article.is-active").forEach((el) => {
        el.classList.remove("is-active");
      });
      if (!isActive) {
        article.classList.add("is-active");
      }
    });

    // 卡片顶部：桌面端（sm:）左右单行对齐；窄屏手机端作者单占一行，时间与操作按钮（眼睛、垃圾桶）自然排在作者下方一行，视觉极其清爽不挤压
    const header = document.createElement("div");
    header.className = "flex flex-col sm:flex-row sm:items-center justify-between gap-y-1.5 pb-2 border-b border-neutral-100";

    const leftInfo = document.createElement("div");
    leftInfo.className = "flex items-center space-x-1.5";
    leftInfo.innerHTML = `
      <img src="https://avatars.githubusercontent.com/${post.author_github}" alt="${post.author_github}" class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full border border-neutral-200 object-cover" />
      <span class="text-xs font-medium text-neutral-800">${post.author_github}</span>
      ${post.author_github.toLowerCase() === AUTHOR_GITHUB.toLowerCase() ? '<span class="text-[9px] font-mono bg-neutral-900 text-white px-1 py-0.2 rounded-xs">Author</span>' : ''}
    `;

    const rightInfo = document.createElement("div");
    rightInfo.className = "flex items-center space-x-2 text-xs font-mono text-neutral-400 sm:ml-auto";
    
    // 如果是非博主访客查看（理论上已被过滤，作为保底展示）
    if (!isAuthor && post.is_private) {
      rightInfo.innerHTML += `
        <span class="inline-flex items-center text-neutral-400" title="该动态仅博主本人可见">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 10s3.5 6 10 6 10-6 10-6"/>
            <path d="M5 13.5L3 17"/>
            <path d="M9 16L8 20"/>
            <path d="M15 16L16 20"/>
            <path d="M19 13.5L21 17"/>
          </svg>
        </span>
      `;
    }

    rightInfo.innerHTML += `
      <time title="${postDate.toLocaleString()}" class="transition-colors hover:text-neutral-600 whitespace-nowrap">${cardTimeInfo.display}</time>
    `;

    if (isAuthor) {
      const isPriv = Boolean(post.is_private);
      // 切换公开/私密状态按钮：纯图标（睁眼=公开，真正闭眼带睫毛=仅我可见）
      const privacyBtn = document.createElement("button");
      privacyBtn.className = isPriv
        ? "text-neutral-700 hover:text-neutral-900 p-1 rounded hover:bg-neutral-100 transition-colors cursor-pointer select-none flex items-center justify-center"
        : "text-neutral-350 hover:text-neutral-700 p-1 rounded hover:bg-neutral-100 transition-colors cursor-pointer select-none flex items-center justify-center";
      privacyBtn.title = isPriv ? "当前状态：仅我可见（点击公开）" : "当前状态：公开（点击设为仅我可见）";

      privacyBtn.innerHTML = isPriv
        ? closedEyeSvg
        : '<i class="ph ph-eye text-sm"></i>';
      privacyBtn.addEventListener("click", async (e) => {
        e.stopPropagation();
        const currentPriv = Boolean(post.is_private);
        await handleTogglePrivacy(post.id, !currentPriv, privacyBtn, post);
      });
      rightInfo.appendChild(privacyBtn);

      // 编辑标签按钮 (纯图标)
      const tagEditHeaderBtn = document.createElement("button");
      tagEditHeaderBtn.className = "text-neutral-350 hover:text-neutral-900 transition-colors p-1 rounded hover:bg-neutral-100 cursor-pointer";
      tagEditHeaderBtn.title = "编辑该动态标签";
      tagEditHeaderBtn.innerHTML = '<i class="ph ph-tag text-sm"></i>';
      tagEditHeaderBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        openEditPostTagsModal(post);
      });
      rightInfo.appendChild(tagEditHeaderBtn);

      // 删除按钮 (黑白素雅线条风格)
      const deleteBtn = document.createElement("button");
      deleteBtn.className = "text-neutral-350 hover:text-neutral-900 transition-colors p-1 rounded hover:bg-neutral-100 cursor-pointer";
      deleteBtn.title = "彻底删除动态及关联图片";
      deleteBtn.innerHTML = '<i class="ph ph-trash text-sm"></i>';
      deleteBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        handleDeletePost(post);
      });
      rightInfo.appendChild(deleteBtn);
    }

    header.appendChild(leftInfo);
    header.appendChild(rightInfo);
    card.appendChild(header);

    // 内容区（解析换行与简单链接）
    const contentDiv = document.createElement("div");
    contentDiv.className = "text-sm text-neutral-800 leading-relaxed font-sans break-words whitespace-pre-wrap";
    contentDiv.innerHTML = escapeAndLinkify(post.content);
    card.appendChild(contentDiv);

    // 标签区 (支持点击直接激活标签筛选；博主可直接添加/编辑标签)
    const hasTags = post.tags && post.tags.length > 0;
    if (hasTags || isAuthor) {
      const tagsDiv = document.createElement("div");
      tagsDiv.className = "post-tags-container flex flex-wrap items-center gap-1.5 pt-1";
      renderPostTagsArea(tagsDiv, post);
      card.appendChild(tagsDiv);
    }

    // 图片九宫格区
    if (post.images && post.images.length > 0) {
      const imgContainer = document.createElement("div");
      const count = post.images.length;

      if (count === 1) {
        imgContainer.className = "pt-1";
        imgContainer.innerHTML = `
          <img src="${post.images[0]}" alt="image" loading="lazy" class="max-h-80 w-auto rounded border border-neutral-200 cursor-zoom-in hover:opacity-95 transition-opacity object-cover" data-src="${post.images[0]}" />
        `;
      } else if (count === 2 || count === 4) {
        imgContainer.className = "grid grid-cols-2 gap-2 pt-1 max-w-md";
        imgContainer.innerHTML = post.images
          .map(url => `<img src="${url}" alt="image" loading="lazy" class="w-full aspect-square rounded border border-neutral-200 object-cover cursor-zoom-in hover:opacity-95 transition-opacity" data-src="${url}" />`)
          .join("");
      } else {
        imgContainer.className = "grid grid-cols-3 gap-2 pt-1 max-w-lg";
        imgContainer.innerHTML = post.images
          .map(url => `<img src="${url}" alt="image" loading="lazy" class="w-full aspect-square rounded border border-neutral-200 object-cover cursor-zoom-in hover:opacity-95 transition-opacity" data-src="${url}" />`)
          .join("");
      }

      imgContainer.querySelectorAll("img").forEach((img, idx) => {
        img.addEventListener("click", () => {
          openLightbox(post.images || [img.getAttribute("data-src") || img.src], idx);
        });
      });

      card.appendChild(imgContainer);
    }

    // 动态下方的追记/补充（Comment）区域
    card.appendChild(renderCommentsSection(post, comments));

    rightCol.appendChild(card);
    article.appendChild(rightCol);

    return article;
  }

  // 渲染单个评论/追记项（支持博主删除与相对时间呈现）
  function createCommentItemElement(comment: CommentItem, post: PostItem): HTMLElement {
    const item = document.createElement("div");
    item.className = "comment-item flex items-start justify-between group/comment bg-neutral-50/70 hover:bg-neutral-50/95 border border-neutral-200/50 rounded px-2.5 py-1.5 transition-colors";
    item.setAttribute("data-comment-id", comment.id);

    const timeInfo = formatCardTime(comment.created_at);

    item.innerHTML = `
      <div class="min-w-0 flex-1 space-y-0.5">
        <div class="flex items-center gap-1.5 text-[10px] text-neutral-400 font-mono select-none">
          <span class="font-medium text-neutral-700">@${comment.author_github}</span>
          <span class="text-[9px] font-mono bg-neutral-900 text-white px-1 py-0.2 rounded-xs">Author</span>
          <span>·</span>
          <time title="${timeInfo.title}">${timeInfo.display}</time>
        </div>
        <div class="text-xs text-neutral-800 font-sans leading-relaxed break-words whitespace-pre-wrap">${escapeAndLinkify(comment.content)}</div>
      </div>
      ${
        isAuthor
          ? '<button type="button" class="btn-del-comment opacity-60 sm:opacity-0 sm:group-hover/comment:opacity-100 text-neutral-400 hover:text-red-600 p-1 -mr-1 ml-1.5 cursor-pointer transition-all shrink-0" title="删除此条追记"><i class="ph ph-trash text-xs"></i></button>'
          : ""
      }
    `;

    if (isAuthor) {
      const delBtn = item.querySelector(".btn-del-comment");
      delBtn?.addEventListener("click", async (e) => {
        e.stopPropagation();
        const container = item.closest(".post-comments-container") as HTMLElement | null;
        await handleDeleteComment(comment.id, post.id, container);
      });
    }

    return item;
  }

  // 渲染动态卡片下方的追记/补充（Comment）区域
  function renderCommentsSection(post: PostItem, comments: CommentItem[] = []): HTMLElement {
    const container = document.createElement("div");
    container.className = "post-comments-container pt-2.5 mt-1 border-t border-neutral-100/80 space-y-1.5";
    container.setAttribute("data-post-comments", post.id);

    // 如果既没有评论，且不是博主，完全隐藏评论区保持卡片极简干净
    if (comments.length === 0 && !isAuthor) {
      container.classList.add("hidden");
      return container;
    }

    // 1. 如果评论数量 > 1 条，根据要求：默认只显示最新一条，其余折叠
    if (comments.length > 1) {
      const olderComments = comments.slice(0, comments.length - 1);
      const latestComment = comments[comments.length - 1];

      // 折叠/展开更早评论控制按钮
      const toggleBtn = document.createElement("button");
      toggleBtn.type = "button";
      toggleBtn.className = "btn-toggle-comments inline-flex items-center gap-1 text-[11px] font-mono text-neutral-400 hover:text-neutral-700 cursor-pointer select-none py-0.5 transition-colors";
      toggleBtn.innerHTML = `<i class="ph ph-caret-right text-[10px] transition-transform"></i><span>展开更早的 ${olderComments.length} 条追记</span>`;

      // 折叠容器
      const olderWrapper = document.createElement("div");
      olderWrapper.className = "older-comments hidden space-y-1.5";
      olderComments.forEach((c) => {
        olderWrapper.appendChild(createCommentItemElement(c, post));
      });

      let isExpanded = false;
      toggleBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        isExpanded = !isExpanded;
        if (isExpanded) {
          olderWrapper.classList.remove("hidden");
          toggleBtn.innerHTML = `<i class="ph ph-caret-down text-[10px] transition-transform"></i><span>收起更早追记</span>`;
        } else {
          olderWrapper.classList.add("hidden");
          toggleBtn.innerHTML = `<i class="ph ph-caret-right text-[10px] transition-transform"></i><span>展开更早的 ${olderComments.length} 条追记</span>`;
        }
      });

      container.appendChild(toggleBtn);
      container.appendChild(olderWrapper);

      // 显示最新的一条评论
      container.appendChild(createCommentItemElement(latestComment, post));
    } else if (comments.length === 1) {
      // 只有 1 条，直接显示该条
      container.appendChild(createCommentItemElement(comments[0], post));
    }

    // 2. 如果是博主本人，提供追加评论的入口与内联输入框
    if (isAuthor) {
      const actionRow = document.createElement("div");
      actionRow.className = "comment-action-row pt-1";

      const openInputBtn = document.createElement("button");
      openInputBtn.type = "button";
      openInputBtn.className = "btn-open-comment inline-flex items-center gap-1 text-[11px] font-mono text-neutral-400 hover:text-neutral-800 cursor-pointer select-none py-0.5 transition-colors";
      openInputBtn.innerHTML = `<i class="ph ph-chat-circle-dots text-xs"></i><span>something more？</span>`;

      const inputForm = document.createElement("div");
      inputForm.className = "comment-input-form hidden pt-1 flex items-center gap-1.5";
      inputForm.innerHTML = `
        <input type="text" placeholder="记录此刻的补充想法..." class="comment-input-field grow bg-neutral-50/80 border border-neutral-200 focus:border-neutral-900 rounded px-2.5 py-1 text-xs text-neutral-800 placeholder:text-neutral-400 font-sans focus:outline-none transition-colors" />
        <button type="button" class="btn-send-comment text-xs font-mono bg-neutral-900 hover:bg-neutral-800 text-white px-2.5 py-1 rounded cursor-pointer select-none shrink-0 transition-colors">发送</button>
        <button type="button" class="btn-cancel-comment text-xs font-mono text-neutral-400 hover:text-neutral-700 px-1 py-1 cursor-pointer select-none shrink-0">取消</button>
      `;

      const inputField = inputForm.querySelector(".comment-input-field") as HTMLInputElement | null;
      const sendBtn = inputForm.querySelector(".btn-send-comment") as HTMLButtonElement | null;
      const cancelBtn = inputForm.querySelector(".btn-cancel-comment");

      openInputBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        openInputBtn.classList.add("hidden");
        inputForm.classList.remove("hidden");
        setTimeout(() => inputField?.focus(), 50);
      });

      cancelBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (inputField) inputField.value = "";
        inputForm.classList.add("hidden");
        openInputBtn.classList.remove("hidden");
      });

      const doSend = async () => {
        const text = inputField?.value.trim();
        if (!text) return;
        if (sendBtn) {
          sendBtn.disabled = true;
          sendBtn.textContent = "...";
        }
        await handleAddComment(post.id, text, container);
      };

      sendBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        doSend();
      });

      inputField?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          doSend();
        } else if (e.key === "Escape") {
          inputField.value = "";
          inputForm.classList.add("hidden");
          openInputBtn.classList.remove("hidden");
        }
      });

      actionRow.appendChild(openInputBtn);
      actionRow.appendChild(inputForm);
      container.appendChild(actionRow);
    }

    return container;
  }

  // 发表追记评论
  async function handleAddComment(postId: string, text: string, container?: HTMLElement | null) {
    if (!currentUser || !isAuthor) {
      alert("仅博主可以发表追记补充。");
      return;
    }
    try {
      const githubUsername = currentUser.user_metadata?.user_name || AUTHOR_GITHUB;
      const { error } = await supabase
        .from("daily_comments")
        .insert([
          {
            post_id: postId,
            content: text,
            author_github: githubUsername,
          },
        ]);

      if (error) throw error;

      await refreshSinglePostComments(postId, container);
    } catch (err: any) {
      console.error("发表追记失败:", err);
      alert(`发表失败: ${err.message || "请检查网络或 Supabase 权限"}`);
    }
  }

  // 删除某条追记评论
  async function handleDeleteComment(commentId: string, postId: string, container?: HTMLElement | null) {
    const confirmed = await showConfirmModal({
      title: "删除追记",
      message: "确定要彻底删除这条补充追记吗？删除后无法恢复。",
      confirmText: "确定删除",
      isDanger: true,
    });
    if (!confirmed) return;

    try {
      const { error } = await supabase
        .from("daily_comments")
        .delete()
        .eq("id", commentId);

      if (error) throw error;

      await refreshSinglePostComments(postId, container);
    } catch (err: any) {
      console.error("删除追记失败:", err);
      alert(`删除失败: ${err.message || "请检查网络或 Supabase 权限"}`);
    }
  }

  // 单卡片评论原位无损刷新（不重载整页与滚动条）
  async function refreshSinglePostComments(postId: string, container?: HTMLElement | null) {
    if (!container) {
      container = document.querySelector(`.post-comments-container[data-post-comments="${postId}"]`);
    }
    if (!container) return;

    try {
      const { data: commentsData } = await supabase
        .from("daily_comments")
        .select("*")
        .eq("post_id", postId)
        .order("created_at", { ascending: true });

      const newComments: CommentItem[] = commentsData || [];
      const parentCard = container.parentElement;
      if (parentCard) {
        const dummyPost: PostItem = { id: postId, author_github: AUTHOR_GITHUB, content: "", created_at: "" };
        const newCommentsEl = renderCommentsSection(dummyPost, newComments);
        parentCard.replaceChild(newCommentsEl, container);
      }
    } catch (e) {
      console.error("刷新追记失败:", e);
    }
  }

  // 大图预览交互 (支持单条动态多图画廊左右切换、键盘箭头与手机滑动手势)
  function openLightbox(images: string[], startIndex = 0) {
    if (!lightboxModal || !lightboxImg || images.length === 0) return;

    galleryImages = images;
    currentGalleryIndex = Math.max(0, Math.min(startIndex, images.length - 1));

    updateLightboxImage();

    lightboxModal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function updateLightboxImage() {
    if (!lightboxImg || galleryImages.length === 0) return;

    lightboxImg.src = galleryImages[currentGalleryIndex];

    const hasMultiple = galleryImages.length > 1;

    if (hasMultiple) {
      lightboxCounter?.classList.remove("hidden");
      lightboxPrev?.classList.remove("hidden");
      lightboxNext?.classList.remove("hidden");
      if (lightboxCurrentIdx) lightboxCurrentIdx.textContent = String(currentGalleryIndex + 1);
      if (lightboxTotalIdx) lightboxTotalIdx.textContent = String(galleryImages.length);
    } else {
      lightboxCounter?.classList.add("hidden");
      lightboxPrev?.classList.add("hidden");
      lightboxNext?.classList.add("hidden");
    }
  }

  function showPrevImage() {
    if (galleryImages.length <= 1) return;
    currentGalleryIndex = (currentGalleryIndex - 1 + galleryImages.length) % galleryImages.length;
    updateLightboxImage();
  }

  function showNextImage() {
    if (galleryImages.length <= 1) return;
    currentGalleryIndex = (currentGalleryIndex + 1) % galleryImages.length;
    updateLightboxImage();
  }

  function closeLightbox() {
    if (!lightboxModal) return;
    lightboxModal.classList.add("hidden");
    document.body.style.overflow = "";
    galleryImages = [];
    currentGalleryIndex = 0;
  }

  lightboxClose?.addEventListener("click", closeLightbox);
  lightboxPrev?.addEventListener("click", (e) => {
    e.stopPropagation();
    showPrevImage();
  });
  lightboxNext?.addEventListener("click", (e) => {
    e.stopPropagation();
    showNextImage();
  });

  lightboxModal?.addEventListener("click", (e) => {
    // 点击背景空白区域关闭（点击图片或按钮不关闭）
    if (e.target === lightboxModal || (e.target as HTMLElement).id === "lightbox-stage") {
      closeLightbox();
    }
  });

  lightboxModal?.addEventListener("wheel", (e) => e.preventDefault(), { passive: false });
  lightboxModal?.addEventListener("touchmove", (e) => e.preventDefault(), { passive: false });

  // 键盘 Esc 关闭、左右箭头切换图片
  window.addEventListener("keydown", (e) => {
    if (!lightboxModal || lightboxModal.classList.contains("hidden")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showPrevImage();
    if (e.key === "ArrowRight") showNextImage();
  });

  // 移动端手指左右轻扫手势切图
  let touchStartX = 0;
  let touchStartY = 0;

  lightboxModal?.addEventListener(
    "touchstart",
    (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    },
    { passive: true }
  );

  lightboxModal?.addEventListener(
    "touchend",
    (e: TouchEvent) => {
      if (galleryImages.length <= 1) return;
      const touchEndX = e.changedTouches[0].clientX;
      const touchEndY = e.changedTouches[0].clientY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      // 水平滑动距离大于 40px 且明显大于垂直移动时触发切图
      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX > 0) {
          // 向右滑 -> 查看上一张
          showPrevImage();
        } else {
          // 向左滑 -> 查看下一张
          showNextImage();
        }
      }
    },
    { passive: true }
  );

  // 更新待上传图片预览
  function updateImagePreviews() {
    if (!imagePreviewList) return;
    if (selectedFiles.length === 0) {
      imagePreviewList.classList.add("hidden");
      imagePreviewList.innerHTML = "";
      return;
    }

    imagePreviewList.classList.remove("hidden");
    imagePreviewList.innerHTML = "";

    selectedFiles.forEach((file, index) => {
      const item = document.createElement("div");
      item.className = "relative group aspect-square rounded border border-neutral-200 overflow-hidden bg-neutral-50";

      const img = document.createElement("img");
      img.className = "w-full h-full object-cover";
      img.src = URL.createObjectURL(file);

      const delBtn = document.createElement("button");
      delBtn.className = "absolute top-1 right-1 bg-black/60 hover:bg-black text-white rounded-full w-5 h-5 flex items-center justify-center text-xs transition-colors cursor-pointer";
      delBtn.innerHTML = '<i class="ph ph-x"></i>';
      delBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        selectedFiles.splice(index, 1);
        updateImagePreviews();
      });

      item.appendChild(img);
      item.appendChild(delBtn);
      imagePreviewList.appendChild(item);
    });
  }

  // 处理图片选择
  imageFileInput?.addEventListener("change", () => {
    if (!imageFileInput.files) return;
    const newFiles = Array.from(imageFileInput.files);
    selectedFiles = [...selectedFiles, ...newFiles].slice(0, 9);
    imageFileInput.value = "";
    updateImagePreviews();
  });

  // 处理直接粘贴截图 (Ctrl+V)
  contentInput?.addEventListener("paste", (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;

    for (let i = 0; i < items.length; i++) {
      if (items[i].type.indexOf("image") !== -1) {
        const file = items[i].getAsFile();
        if (file) {
          e.preventDefault();
          selectedFiles.push(file);
          if (selectedFiles.length > 9) selectedFiles = selectedFiles.slice(0, 9);
          updateImagePreviews();
        }
      }
    }
  });

  // ===== 标签管理与筛选系统 =====

  // 加载全站可用标签（合并 daily_tags 表与已有动态中的标签，同时精确统计各标签使用次数）
  async function loadAllTags() {
    const allSet = new Set<string>();
    const usedSet = new Set<string>();
    tagUsageMap = {};

    // 1. 尝试从专用的 daily_tags 标签表查询已创建的标签
    try {
      const { data: tagTableData } = await supabase
        .from("daily_tags")
        .select("name")
        .order("name", { ascending: true });
      if (tagTableData) {
        tagTableData.forEach((row: any) => {
          if (row?.name) {
            const clean = String(row.name).replace(/^#/, "").trim();
            if (clean) allSet.add(clean);
          }
        });
      }
    } catch (e) {}

    // 2. 同时从已发布的所有动态中提取所有历史标签，确保即使标签表未创建或不完整也不会丢失任何标签
    try {
      const { data: postsData } = await supabase
        .from("daily_posts")
        .select("tags");
      if (postsData) {
        postsData.forEach((p: any) => {
          if (Array.isArray(p?.tags)) {
            p.tags.forEach((t: string) => {
              const clean = String(t).replace(/^#/, "").trim();
              if (clean) {
                allSet.add(clean);
                usedSet.add(clean);
                tagUsageMap[clean] = (tagUsageMap[clean] || 0) + 1;
              }
            });
          }
        });
      }
    } catch (e) {}

    allTags = Array.from(allSet).sort((a, b) => a.localeCompare(b, "zh-CN"));
    // 筛选栏只展示有关联动态的标签
    activeFilterTags = Array.from(usedSet).sort((a, b) => a.localeCompare(b, "zh-CN"));

    renderTagFilterBar();
    renderComposerTagOptions(tagPickerInput?.value || "");
  }

  // 渲染顶部/时间轴上方标签筛选栏（只展示有关联动态标签；若无关联动态标签则整体隐藏，绝不出现“暂无标签”）
  function renderTagFilterBar() {
    if (!tagFilterBar || !tagFilterList) return;

    if (activeFilterTags.length === 0) {
      tagFilterBar.classList.add("hidden");
      tagFilterList.innerHTML = "";
      return;
    }

    tagFilterBar.classList.remove("hidden");

    // 更新“全部”按钮样式
    if (tagFilterAllBtn) {
      if (currentTagFilter === null) {
        tagFilterAllBtn.className = "tag-filter-pill active inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-900 text-white transition-colors cursor-pointer";
      } else {
        tagFilterAllBtn.className = "tag-filter-pill inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-100 hover:bg-neutral-200 text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer";
      }
    }

    tagFilterList.innerHTML = "";
    activeFilterTags.forEach((tag) => {
      const btn = document.createElement("button");
      btn.type = "button";
      const isActive = currentTagFilter === tag;
      btn.className = isActive
        ? "inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-900 text-white transition-colors cursor-pointer"
        : "inline-flex items-center text-[11px] font-mono px-2 py-0.5 rounded-sm bg-neutral-100 hover:bg-neutral-200 text-neutral-600 hover:text-neutral-900 transition-colors cursor-pointer";
      btn.textContent = `#${tag}`;
      btn.title = `筛选标签 #${tag}`;
      btn.addEventListener("click", () => {
        setTagFilter(isActive ? null : tag);
      });
      tagFilterList.appendChild(btn);
    });
  }

  // 设置当前标签筛选
  async function setTagFilter(tag: string | null) {
    currentTagFilter = tag;
    renderTagFilterBar();
    await loadPosts(0, false);
  }

  // 渲染发布框中已选中的标签胶囊
  function renderComposerSelectedTags() {
    if (!composerSelectedTagsContainer) return;
    composerSelectedTagsContainer.innerHTML = "";
    selectedComposeTags.forEach((tag) => {
      const pill = document.createElement("span");
      pill.className = "inline-flex items-center gap-1 text-xs font-mono bg-neutral-100 text-neutral-800 px-2 py-0.5 rounded border border-neutral-200/80 shadow-2xs select-none";
      pill.innerHTML = `<span>#${tag}</span><button type="button" class="text-neutral-400 hover:text-neutral-700 cursor-pointer p-0.5 -mr-0.5" title="移除"><i class="ph ph-x text-[10px]"></i></button>`;
      const removeBtn = pill.querySelector("button");
      removeBtn?.addEventListener("click", () => {
        selectedComposeTags = selectedComposeTags.filter((t) => t !== tag);
        renderComposerSelectedTags();
        renderComposerTagOptions(tagPickerInput?.value || "");
      });
      composerSelectedTagsContainer.appendChild(pill);
    });
  }

  // 渲染标签选择浮层中的已有标签备选区及新建按钮
  function renderComposerTagOptions(keyword: string = "") {
    if (!tagPickerOptions) return;
    const kw = keyword.trim().replace(/^#/, "").toLowerCase();

    // 合并展示池：已有标签 + 当前草稿已选标签
    const displayPool = Array.from(new Set([...allTags, ...selectedComposeTags])).sort((a, b) => a.localeCompare(b, "zh-CN"));

    // 控制“新建标签”按钮呈现（仅当用户输入了内容且不存在于 displayPool 时展示）
    if (tagPickerCreateBtn && newTagNamePreview) {
      const exactMatch = displayPool.some((t) => t.toLowerCase() === kw);
      if (kw && !exactMatch) {
        newTagNamePreview.textContent = keyword.trim().replace(/^#/, "");
        tagPickerCreateBtn.classList.remove("hidden");
      } else {
        tagPickerCreateBtn.classList.add("hidden");
      }
    }

    const filtered = displayPool.filter((t) => t.toLowerCase().includes(kw));
    tagPickerOptions.innerHTML = "";

    if (filtered.length === 0) {
      const emptySpan = document.createElement("span");
      emptySpan.className = "text-[11px] text-neutral-400 py-1";
      emptySpan.textContent = kw ? "无匹配标签，按回车或点上方新建" : "暂无已有标签，可输入新建";
      tagPickerOptions.appendChild(emptySpan);
      return;
    }

    filtered.forEach((tag) => {
      const isSelected = selectedComposeTags.includes(tag);
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = isSelected
        ? "inline-flex items-center gap-1 text-[11px] font-mono px-2 py-0.5 rounded bg-neutral-900 text-white cursor-pointer select-none transition-colors"
        : "inline-flex items-center gap-1 text-[11px] font-mono px-2 py-0.5 rounded bg-neutral-100 hover:bg-neutral-200 text-neutral-700 cursor-pointer select-none transition-colors";
      btn.innerHTML = `${isSelected ? '<i class="ph ph-check text-[10px]"></i>' : ""}#${tag}`;
      btn.addEventListener("click", () => {
        if (isSelected) {
          selectedComposeTags = selectedComposeTags.filter((t) => t !== tag);
        } else {
          selectedComposeTags.push(tag);
        }
        renderComposerSelectedTags();
        renderComposerTagOptions(tagPickerInput?.value || "");
      });
      tagPickerOptions.appendChild(btn);
    });
  }

  // 发帖输入框中选中或添加标签（支持新建标签立即存库保存到标签池，但筛选栏仍只在关联动态发布后才展示该标签）
  async function handleSelectOrCreateComposeTag(rawName: string) {
    const clean = rawName.replace(/^#/, "").trim();
    if (!clean) return;

    // 存入全站标签库
    if (!allTags.includes(clean)) {
      allTags.push(clean);
      allTags.sort((a, b) => a.localeCompare(b, "zh-CN"));
      try {
        await supabase.from("daily_tags").insert([{ name: clean }]);
      } catch (e) {}
    }

    if (!selectedComposeTags.includes(clean)) {
      selectedComposeTags.push(clean);
      renderComposerSelectedTags();
    }

    if (tagPickerInput) {
      tagPickerInput.value = "";
    }
    renderComposerTagOptions("");
  }

  // ===== 标签管理功能 (Modal) =====

  async function openTagManagerModal() {
    if (!isAuthor || !tagManagerModal) return;

    tagManagerModal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    if (tagManagerNewInput) tagManagerNewInput.value = "";

    await refreshTagManagerData();
  }

  function closeTagManagerModal() {
    if (!tagManagerModal) return;
    tagManagerModal.classList.add("hidden");
    document.body.style.overflow = "";
  }

  async function refreshTagManagerData() {
    if (!tagManagerList) return;
    tagManagerList.innerHTML = '<div class="text-center py-4 text-neutral-400 text-xs"><i class="ph ph-spinner animate-spin text-sm mr-1"></i>加载标签数据...</div>';

    // 重新获取全站标签
    await loadAllTags();

    // 统计每种标签的使用动态数量
    tagUsageMap = {};
    try {
      const { data: postsData } = await supabase.from("daily_posts").select("tags");
      if (postsData) {
        postsData.forEach((p: any) => {
          if (Array.isArray(p?.tags)) {
            p.tags.forEach((t: string) => {
              const clean = String(t).replace(/^#/, "").trim();
              if (clean) tagUsageMap[clean] = (tagUsageMap[clean] || 0) + 1;
            });
          }
        });
      }
    } catch (e) {}

    renderTagManagerList();
  }

  function renderTagManagerList() {
    if (!tagManagerList) return;
    if (tagManagerTotalCount) {
      tagManagerTotalCount.textContent = `共 ${allTags.length} 个标签`;
    }

    if (allTags.length === 0) {
      tagManagerList.innerHTML = '<div class="text-center py-6 text-neutral-400 text-xs">当前还没有任何标签，可在上方输入新建</div>';
      return;
    }

    tagManagerList.innerHTML = "";
    allTags.forEach((tag) => {
      const count = tagUsageMap[tag] || 0;
      const row = document.createElement("div");
      row.className = "flex items-center justify-between p-1.5 rounded hover:bg-neutral-50 transition-colors group";
      row.setAttribute("data-tag-row", tag);

      row.innerHTML = `
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="font-medium text-neutral-800 text-xs truncate">#${tag}</span>
          <span class="text-[10px] text-neutral-400 shrink-0">(${count} 篇动态)</span>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button type="button" class="btn-rename text-neutral-400 hover:text-neutral-800 p-1 rounded hover:bg-neutral-200/50 cursor-pointer" title="重命名">
            <i class="ph ph-pencil-simple text-xs"></i>
          </button>
          <button type="button" class="btn-delete text-neutral-400 hover:text-red-600 p-1 rounded hover:bg-red-50 cursor-pointer" title="删除">
            <i class="ph ph-trash text-xs"></i>
          </button>
        </div>
      `;

      const renameBtn = row.querySelector(".btn-rename");
      const deleteBtn = row.querySelector(".btn-delete");

      renameBtn?.addEventListener("click", () => {
        row.innerHTML = `
          <div class="flex items-center gap-1.5 grow mr-2">
            <input type="text" class="rename-input grow bg-neutral-50 border border-neutral-300 rounded px-1.5 py-0.5 text-xs text-neutral-800 focus:outline-none focus:border-neutral-800" value="${tag}" />
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" class="btn-save-rename text-xs text-neutral-900 bg-neutral-200 hover:bg-neutral-300 px-2 py-0.5 rounded cursor-pointer">保存</button>
            <button type="button" class="btn-cancel-rename text-xs text-neutral-500 hover:text-neutral-800 px-1 py-0.5 cursor-pointer">取消</button>
          </div>
        `;
        const renameInput = row.querySelector(".rename-input") as HTMLInputElement | null;
        const saveBtn = row.querySelector(".btn-save-rename");
        const cancelBtn = row.querySelector(".btn-cancel-rename");

        renameInput?.focus();
        renameInput?.select();

        const doSave = async () => {
          const newName = renameInput?.value.replace(/^#/, "").trim() || "";
          if (!newName || newName === tag) {
            renderTagManagerList();
            return;
          }
          await handleRenameTag(tag, newName);
        };

        saveBtn?.addEventListener("click", doSave);
        renameInput?.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            doSave();
          } else if (e.key === "Escape") {
            renderTagManagerList();
          }
        });
        cancelBtn?.addEventListener("click", () => renderTagManagerList());
      });

      deleteBtn?.addEventListener("click", async () => {
        await handleDeleteTag(tag, count);
      });

      tagManagerList.appendChild(row);
    });
  }

  // 重命名标签（级联更新 daily_tags 表与所有相关动态）
  async function handleRenameTag(oldName: string, newName: string) {
    try {
      // 1. 更新 daily_tags 表
      const { error: tagError } = await supabase
        .from("daily_tags")
        .update({ name: newName })
        .eq("name", oldName);
      if (tagError) console.warn("更新 daily_tags 表提示:", tagError);

      // 2. 查询并级联更新所有包含 oldName 的动态
      const { data: affectedPosts } = await supabase
        .from("daily_posts")
        .select("id, tags")
        .contains("tags", [oldName]);

      if (affectedPosts && affectedPosts.length > 0) {
        for (const post of affectedPosts) {
          const updatedTags = Array.from(new Set(
            (post.tags || []).map((t: string) => {
              const clean = t.replace(/^#/, "").trim();
              return clean === oldName ? newName : clean;
            })
          ));
          await supabase.from("daily_posts").update({ tags: updatedTags }).eq("id", post.id);
        }
      }

      // 如果当前筛选正是此标签，同步更新筛选状态
      if (currentTagFilter === oldName) {
        currentTagFilter = newName;
      }

      await loadAllTags();
      await loadPosts(0, false);
      await refreshTagManagerData();
    } catch (err: any) {
      console.error("重命名标签失败:", err);
      alert(`重命名失败: ${err.message || "请检查网络或 Supabase 权限"}`);
    }
  }

  // 删除标签（级联从 daily_tags 表删除，并从所有动态的 tags 中剔除）
  async function handleDeleteTag(tagName: string, count: number) {
    const message = count > 0
      ? `确定要删除标签 #${tagName} 吗？当前有 ${count} 篇动态正在使用该标签，删除后将同时从这些动态中移除此标签。`
      : `确定要删除标签 #${tagName} 吗？该标签当前未被任何动态使用。`;

    const confirmed = await showConfirmModal({
      title: "删除标签",
      message,
      confirmText: "确定删除",
      isDanger: true,
    });

    if (!confirmed) return;

    try {
      // 1. 从 daily_tags 表中删除
      const { error: tagDelErr } = await supabase
        .from("daily_tags")
        .delete()
        .eq("name", tagName);
      if (tagDelErr) console.warn("从 daily_tags 表删除提示:", tagDelErr);

      // 2. 查询并级联从所有动态中移除 tagName
      const { data: affectedPosts } = await supabase
        .from("daily_posts")
        .select("id, tags")
        .contains("tags", [tagName]);

      if (affectedPosts && affectedPosts.length > 0) {
        for (const post of affectedPosts) {
          const updatedTags = (post.tags || []).filter((t: string) => t.replace(/^#/, "").trim() !== tagName);
          await supabase.from("daily_posts").update({ tags: updatedTags }).eq("id", post.id);
        }
      }

      // 如果当前筛选正是此标签，重置筛选为全部
      if (currentTagFilter === tagName) {
        currentTagFilter = null;
      }

      await loadAllTags();
      await loadPosts(0, false);
      await refreshTagManagerData();
    } catch (err: any) {
      console.error("删除标签失败:", err);
      alert(`删除标签失败: ${err.message || "请检查网络或 Supabase 权限"}`);
    }
  }

  // 在标签管理器中直接新建标签
  async function handleAddNewTagInManager() {
    if (!tagManagerNewInput) return;
    const clean = tagManagerNewInput.value.replace(/^#/, "").trim();
    if (!clean) return;

    if (allTags.includes(clean)) {
      alert(`标签 #${clean} 已存在！`);
      return;
    }

    try {
      const { error } = await supabase.from("daily_tags").insert([{ name: clean }]);
      if (error) throw error;

      tagManagerNewInput.value = "";
      await loadAllTags();
      await refreshTagManagerData();
    } catch (err: any) {
      console.error("新建标签失败:", err);
      alert(`新建标签失败: ${err.message || "请检查权限"}`);
    }
  }

  // 将动态追加渲染到时间轴流中（智能识别是否跨天，同天自动合流）
  function appendPostsToStream(posts: PostItem[], commentsMap: Record<string, CommentItem[]> = {}) {
    if (!streamContainer) return;

    posts.forEach((post) => {
      const postDate = new Date(post.created_at);
      const dateKey = `${postDate.getFullYear()}-${postDate.getMonth() + 1}-${postDate.getDate()}`;
      const postComments = commentsMap[post.id] || [];

      let lastGroup = streamContainer.lastElementChild as HTMLElement | null;
      if (
        lastGroup &&
        lastGroup.classList.contains("timeline-day-group") &&
        lastGroup.getAttribute("data-date-key") === dateKey
      ) {
        lastGroup.appendChild(renderTimelineNode(post, false, postComments));
      } else {
        const newGroup = document.createElement("div");
        newGroup.className = "timeline-day-group";
        newGroup.setAttribute("data-date-key", dateKey);
        newGroup.appendChild(renderTimelineNode(post, true, postComments));
        streamContainer.appendChild(newGroup);
      }
    });
  }

  // 更新分页底栏 UI 状态 (按钮与提示严格互斥，避免并存或闪烁)
  function updatePaginationUI() {
    if (!paginationContainer) return;

    // 如果还没有任何动态发布，完全隐藏分页区
    if (totalCount === 0) {
      paginationContainer.classList.add("hidden");
      return;
    }

    paginationContainer.classList.remove("hidden");

    if (hasMore) {
      // 还有未加载的动态：显示加载按钮，隐藏“已加载全部”提示
      if (allLoadedNotice) {
        allLoadedNotice.style.display = "none";
        allLoadedNotice.classList.add("hidden");
      }
      if (loadMoreBtn) {
        loadMoreBtn.style.display = "inline-flex";
        loadMoreBtn.classList.remove("hidden");
        loadMoreBtn.disabled = false;
      }
      if (loadMoreSpinner) loadMoreSpinner.classList.add("hidden");
      if (loadMoreIcon) loadMoreIcon.classList.remove("hidden");
      if (loadMoreText) loadMoreText.textContent = "加载更早动态";
    } else {
      // 已加载完毕：彻底隐藏加载按钮，显示“已加载全部动态”
      if (loadMoreBtn) {
        loadMoreBtn.style.display = "none";
        loadMoreBtn.classList.add("hidden");
      }
      if (allLoadedNotice) {
        allLoadedNotice.style.display = "block";
        allLoadedNotice.classList.remove("hidden");
      }
    }
  }

  // 请求序号，防止并发竞争导致重复渲染
  let currentLoadSeq = 0;

  // 加载时间轴动态 (支持分页，访客只加载公开动态，博主登录后加载全部包含私密动态)
  async function loadPosts(page = 0, isAppend = false) {
    const seq = ++currentLoadSeq;
    try {
      if (!isAppend) {
        page = 0; // 核心保障：非追加模式下始终从第 0 页开始查询，彻底杜绝中间页码导致最新动态被裁切丢失的范围错位 bug
        currentPage = 0;
        if (skeleton) skeleton.style.display = "block";
        if (paginationContainer) paginationContainer.classList.add("hidden");
      }

      const from = page * PAGE_SIZE;
      const to = from + PAGE_SIZE - 1;

      let query = supabase
        .from("daily_posts")
        .select("*", { count: "exact" })
        .order("created_at", { ascending: false });

      if (!isAuthor) {
        query = query.eq("is_private", false);
      }

      // 如果激活了标签筛选，通过 Supabase contains 进行数组匹配
      if (currentTagFilter) {
        query = query.contains("tags", [currentTagFilter]);
      }

      const { data, count, error } = await query.range(from, to);

      // 如果有更新的请求发起，丢弃此过期请求的结果
      if (seq !== currentLoadSeq) return;

      if (!isAppend && skeleton) skeleton.style.display = "none";

      if (error) {
        console.error("加载动态失败:", error);
        return;
      }

      if (!streamContainer) return;

      if (!isAppend) {
        streamContainer.innerHTML = "";
      }

      totalCount = count || 0;
      if (countBadge) {
        countBadge.textContent = String(totalCount);
        if (totalCount > 0) countBadge.classList.remove("hidden");
        else countBadge.classList.add("hidden");
      }

      const posts: PostItem[] = data || [];

      if (!isAppend && posts.length === 0) {
        if (emptyState) {
          emptyState.classList.remove("hidden");
          const emptyText = emptyState.querySelector("p");
          if (emptyText) {
            emptyText.textContent = currentTagFilter
              ? `未找到包含标签 #${currentTagFilter} 的动态`
              : "No daily notes yet.";
          }
        }
        if (paginationContainer) paginationContainer.classList.add("hidden");
        return;
      }

      if (emptyState) emptyState.classList.add("hidden");

      // 批量查询当前页动态的所有追记评论
      let commentsMap: Record<string, CommentItem[]> = {};
      if (posts.length > 0) {
        try {
          const postIds = posts.map((p) => p.id);
          const { data: commentsData } = await supabase
            .from("daily_comments")
            .select("*")
            .in("post_id", postIds)
            .order("created_at", { ascending: true });
          if (commentsData) {
            commentsData.forEach((c: any) => {
              if (!commentsMap[c.post_id]) commentsMap[c.post_id] = [];
              commentsMap[c.post_id].push(c);
            });
          }
        } catch (e) {
          // daily_comments 表尚未创建时的保底容错
        }
      }

      appendPostsToStream(posts, commentsMap);

      // 计算是否还有下一页：当前已拉取的总量是否小于数据库总数，且当前拉到了数据
      hasMore = (page + 1) * PAGE_SIZE < totalCount && posts.length > 0;
      currentPage = page;
      updatePaginationUI();
    } catch (err) {
      console.error("请求异常:", err);
      if (seq === currentLoadSeq && !isAppend && skeleton) skeleton.style.display = "none";
    }
  }

  // 加载下一页更早动态
  async function loadMore() {
    if (isLoadingMore || !hasMore) return;
    isLoadingMore = true;

    if (allLoadedNotice) {
      allLoadedNotice.style.display = "none";
      allLoadedNotice.classList.add("hidden");
    }
    if (loadMoreBtn) {
      loadMoreBtn.style.display = "inline-flex";
      loadMoreBtn.classList.remove("hidden");
      loadMoreBtn.disabled = true;
    }
    if (loadMoreSpinner) loadMoreSpinner.classList.remove("hidden");
    if (loadMoreIcon) loadMoreIcon.classList.add("hidden");
    if (loadMoreText) loadMoreText.textContent = "正在加载...";

    await loadPosts(currentPage + 1, true);

    isLoadingMore = false;
  }

  // 前端 Canvas 智能压缩图片：将手机拍摄的大图（常见 4M~12M）智能缩放至最大 1600px，输出 ~200KB 的高画质 JPEG，解决跨境网络上传慢、超时失败 (TypeError: Load failed)
  async function compressImage(file: File): Promise<File> {
    if (!file.type.startsWith("image/") || file.type === "image/gif" || file.type === "image/svg+xml") {
      return file;
    }

    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const MAX_DIM = 1600;
          let width = img.width;
          let height = img.height;

          if (width > MAX_DIM || height > MAX_DIM) {
            if (width > height) {
              height = Math.round((height * MAX_DIM) / width);
              width = MAX_DIM;
            } else {
              width = Math.round((width * MAX_DIM) / height);
              height = MAX_DIM;
            }
          }

          const canvas = document.createElement("canvas");
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext("2d");
          if (!ctx) {
            resolve(file);
            return;
          }

          ctx.drawImage(img, 0, 0, width, height);

          canvas.toBlob(
            (blob) => {
              if (!blob || blob.size >= file.size) {
                resolve(file);
                return;
              }
              const cleanName = file.name.replace(/\.[^/.]+$/, "") + ".jpg";
              const compressedFile = new File([blob], cleanName, {
                type: "image/jpeg",
                lastModified: Date.now(),
              });
              resolve(compressedFile);
            },
            "image/jpeg",
            0.82
          );
        };
        img.onerror = () => resolve(file);
        img.src = e.target?.result as string;
      };
      reader.onerror = () => resolve(file);
      reader.readAsDataURL(file);
    });
  }

  // 上传图片到 Supabase Storage
  async function uploadImage(file: File): Promise<string> {
    const ext = file.name.split(".").pop() || "jpg";
    const cleanName = `${Date.now()}_${Math.random().toString(36).substring(2, 8)}.${ext}`;
    const filePath = `daily/${cleanName}`;

    const { error } = await supabase.storage
      .from(BUCKET_NAME)
      .upload(filePath, file, { cacheControl: "31536000", upsert: false });

    if (error) {
      throw error;
    }

    const { data } = supabase.storage.from(BUCKET_NAME).getPublicUrl(filePath);
    return data.publicUrl;
  }

  // 提交发布动态
  async function handlePublish() {
    if (!contentInput || !submitBtn) return;
    const content = contentInput.value.trim();

    if (!content && selectedFiles.length === 0) {
      alert("请输入内容或添加图片后再发布！");
      return;
    }

    if (!currentUser || !isAuthor) {
      alert("只有博主本人可以发布动态。");
      return;
    }

    submitBtn.disabled = true;
    submitSpinner?.classList.remove("hidden");
    submitIcon?.classList.add("hidden");
    if (submitText) submitText.textContent = "准备发布...";

    try {
      const uploadedUrls: string[] = [];
      for (let i = 0; i < selectedFiles.length; i++) {
        const file = selectedFiles[i];
        if (submitText) submitText.textContent = `压缩图片 (${i + 1}/${selectedFiles.length})...`;
        const compressed = await compressImage(file);
        if (submitText) submitText.textContent = `上传图片 (${i + 1}/${selectedFiles.length})...`;
        const url = await uploadImage(compressed);
        uploadedUrls.push(url);
      }
      if (submitText) submitText.textContent = "保存动态...";

      const tags = [...selectedComposeTags];

      const isPrivate = privateInput ? privateInput.checked : false;
      const githubUsername = currentUser.user_metadata?.user_name || AUTHOR_GITHUB;

      const { data, error } = await supabase
        .from("daily_posts")
        .insert([
          {
            content,
            images: uploadedUrls,
            tags,
            author_github: githubUsername,
            is_private: isPrivate,
          },
        ])
        .select()
        .single();

      if (error) {
        throw error;
      }

      // 将本次使用的新标签持久化到 daily_tags 表
      if (tags.length > 0) {
        try {
          const tagRows = tags.map((name) => ({ name }));
          await supabase.from("daily_tags").upsert(tagRows, { onConflict: "name" });
        } catch (e) {}
      }

      contentInput.value = "";
      selectedComposeTags = [];
      renderComposerSelectedTags();
      tagPickerPopover?.classList.add("hidden");
      if (privateInput) privateInput.checked = false;
      selectedFiles = [];
      updateImagePreviews();
      composer?.classList.add("hidden");

      // 重新加载标签池与时间轴列表
      await loadAllTags();
      await loadPosts(0, false);
    } catch (err: any) {
      console.error("发布失败:", err);
      const isNetworkError = err?.message?.toLowerCase().includes("failed") || err?.name === "TypeError";
      const hint = isNetworkError
        ? "网络连接不稳定或跨境请求超时，请稍后重试或检查图片大小"
        : (err.message || '请检查权限或网络连接');
      alert(`发布失败: ${hint}`);
    } finally {
      submitBtn.disabled = false;
      submitSpinner?.classList.add("hidden");
      submitIcon?.classList.remove("hidden");
      if (submitText) submitText.textContent = "发布";
    }
  }

  // 切换某条动态的隐私可见性 (公开 <-> 仅我可见)
  async function handleTogglePrivacy(postId: string, newPrivateState: boolean, btn?: HTMLButtonElement, post?: PostItem) {
    try {
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="ph ph-spinner animate-spin text-sm"></i>';
      }

      const { data, error } = await supabase
        .from("daily_posts")
        .update({ is_private: newPrivateState })
        .eq("id", postId)
        .select();

      if (error) {
        throw error;
      }

      console.log(`[DailyFeed] 成功将动态 ${postId} 可见性更新为:`, newPrivateState, data);

      if (post) {
        post.is_private = newPrivateState;
      }

      // 原位静默更新图标与状态，绝不重载列表或导致滚动条跳动
      if (btn) {
        btn.disabled = false;
        btn.className = newPrivateState
          ? "text-neutral-700 hover:text-neutral-900 p-1 rounded hover:bg-neutral-100 transition-colors cursor-pointer select-none flex items-center justify-center"
          : "text-neutral-350 hover:text-neutral-700 p-1 rounded hover:bg-neutral-100 transition-colors cursor-pointer select-none flex items-center justify-center";
        btn.title = newPrivateState ? "当前状态：仅我可见（点击公开）" : "当前状态：公开（点击设为仅我可见）";
        btn.innerHTML = newPrivateState ? closedEyeSvg : '<i class="ph ph-eye text-sm"></i>';
      }
    } catch (err: any) {
      console.error("切换可见性失败:", err);
      alert(`更新可见性失败: ${err.message || '请检查网络或 Supabase RLS 策略'}`);
      if (btn) btn.disabled = false;
    }
  }

  // 删除某条动态 (自定义优雅模态弹窗 + 联动删除 Storage 图片)
  async function handleDeletePost(post: PostItem) {
    const hasImages = post.images && post.images.length > 0;
    const confirmed = await showConfirmModal({
      title: "删除动态",
      message: hasImages
        ? "确定要删除这条动态吗？包含的图片将从云端存储桶一并彻底清除，此操作无法撤销。"
        : "确定要彻底删除这条动态吗？删除后内容无法恢复。",
      confirmText: "确定删除",
      isDanger: true,
    });

    if (!confirmed) return;

    try {
      // 1. 如果包含图片，解析文件路径并联动删除 Storage 中的文件，不留孤儿数据
      if (hasImages && post.images) {
        const filePathsToDelete: string[] = [];
        post.images.forEach((url) => {
          // 例如从 https://.../storage/v1/object/public/daily-images/daily/1234_abc.png 提取 daily/1234_abc.png
          const parts = url.split(`/${BUCKET_NAME}/`);
          if (parts.length > 1) {
            filePathsToDelete.push(parts[1]);
          }
        });

        if (filePathsToDelete.length > 0) {
          const { error: storageError } = await supabase.storage
            .from(BUCKET_NAME)
            .remove(filePathsToDelete);
          if (storageError) {
            console.warn("Storage 图片清理异常 (已忽略以保证动态顺利删除):", storageError);
          }
        }
      }

      // 2. 从数据库中彻底删除动态记录
      const { error } = await supabase
        .from("daily_posts")
        .delete()
        .eq("id", post.id);

      if (error) {
        throw error;
      }

      const card = document.getElementById(`post-${post.id}`);
      if (card) {
        card.style.opacity = "0";
        card.style.transform = "scale(0.95)";
        setTimeout(() => {
          const dayGroup = card.closest(".timeline-day-group");
          card.remove();
          if (dayGroup && dayGroup.children.length === 0) {
            dayGroup.remove();
          }
          totalCount = Math.max(0, totalCount - 1);
          if (countBadge) {
            countBadge.textContent = String(totalCount);
            if (totalCount === 0) {
              countBadge.classList.add("hidden");
              if (emptyState) emptyState.classList.remove("hidden");
            }
          }
          updatePaginationUI();
        }, 300);
      }
    } catch (err: any) {
      console.error("删除失败:", err);
      alert(`删除失败: ${err.message}`);
    }
  }

  // 认证状态监听与处理
  async function initAuth() {
    // 监听认证状态变化（supabase 客户端初始化时会自动触发 INITIAL_SESSION）
    supabase.auth.onAuthStateChange((_event, session) => {
      handleAuthState(session?.user || null);
    });

    // 如果 URL 带有 OAuth 回调参数，静默清理地址栏，避免后续重新授权冲突
    if (window.location.hash.includes("access_token") || window.location.search.includes("code=")) {
      setTimeout(() => {
        window.history.replaceState({}, document.title, window.location.pathname);
      }, 800);
    }
  }

  function handleAuthState(user: any) {
    currentUser = user;
    if (user) {
      const ghUsername = user.user_metadata?.user_name || user.email?.split("@")[0] || "";
      isAuthor = ghUsername.toLowerCase() === AUTHOR_GITHUB.toLowerCase();

      // 彻底隐藏登录按钮
      if (loginBtn) {
        loginBtn.style.display = "none";
        loginBtn.classList.add("hidden");
        loginBtn.classList.remove("inline-flex");
      }

      // 显示用户面板
      if (userPanel) {
        userPanel.style.display = "flex";
        userPanel.classList.remove("hidden");
        userPanel.classList.add("flex");
      }

      if (userAvatar) userAvatar.src = user.user_metadata?.avatar_url || `https://avatars.githubusercontent.com/${ghUsername}`;
      if (userName) userName.textContent = `@${ghUsername}`;

      if (isAuthor) {
        if (toggleComposeBtn) {
          toggleComposeBtn.style.display = "inline-flex";
          toggleComposeBtn.classList.remove("hidden");
          toggleComposeBtn.classList.add("inline-flex");
        }
        if (openTagManagerBtn) {
          openTagManagerBtn.style.display = "flex";
          openTagManagerBtn.classList.remove("hidden");
          openTagManagerBtn.classList.add("flex");
        }
      } else {
        if (toggleComposeBtn) {
          toggleComposeBtn.style.display = "none";
          toggleComposeBtn.classList.add("hidden");
        }
        if (openTagManagerBtn) {
          openTagManagerBtn.style.display = "none";
          openTagManagerBtn.classList.add("hidden");
          openTagManagerBtn.classList.remove("flex");
        }
      }
    } else {
      isAuthor = false;

      // 恢复显示登录按钮
      if (loginBtn) {
        loginBtn.style.display = "inline-flex";
        loginBtn.classList.remove("hidden");
        loginBtn.classList.add("inline-flex");
      }

      // 隐藏用户面板与发帖框
      if (userPanel) {
        userPanel.style.display = "none";
        userPanel.classList.add("hidden");
        userPanel.classList.remove("flex");
      }

      if (toggleComposeBtn) {
        toggleComposeBtn.style.display = "none";
        toggleComposeBtn.classList.add("hidden");
      }
      if (openTagManagerBtn) {
        openTagManagerBtn.style.display = "none";
        openTagManagerBtn.classList.add("hidden");
        openTagManagerBtn.classList.remove("flex");
      }
      composer?.classList.add("hidden");
    }

    // 重新加载并渲染动态列表（同步作者删除操作权限）
    loadPosts();
  }

  // 事件监听绑定
  loginBtn?.addEventListener("click", async () => {
    try {
      // 记录激活 tab 到 sessionStorage 并拼入 redirect 参数，确保登录后直接跳回 daily
      sessionStorage.setItem("active_blog_tab", "daily");
      const cleanRedirectUrl = `${window.location.origin}${window.location.pathname}?tab=daily`;
      const { error } = await supabase.auth.signInWithOAuth({
        provider: "github",
        options: {
          redirectTo: cleanRedirectUrl,
        },
      });
      if (error) {
        console.error("GitHub 登录失败:", error);
        alert("登录失败: " + error.message);
      }
    } catch (err: any) {
      console.error("登录异常:", err);
      alert("登录异常: " + (err.message || err));
    }
  });

  logoutBtn?.addEventListener("click", async () => {
    try {
      await supabase.auth.signOut();
    } catch (e) {
      console.error("退出异常:", e);
    }
    // 清除 URL hash/query，并刷新页面彻底重置所有本地内存状态
    window.history.replaceState({}, document.title, window.location.pathname);
    window.location.reload();
  });

  toggleComposeBtn?.addEventListener("click", () => {
    composer?.classList.toggle("hidden");
    if (!composer?.classList.contains("hidden")) {
      contentInput?.focus();
    }
  });

  cancelComposeBtn?.addEventListener("click", () => {
    composer?.classList.add("hidden");
    tagPickerPopover?.classList.add("hidden");
  });

  submitBtn?.addEventListener("click", handlePublish);
  loadMoreBtn?.addEventListener("click", loadMore);

  // 标签选择与浮层事件绑定
  openTagPickerBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    if (!tagPickerPopover) return;
    const isHidden = tagPickerPopover.classList.contains("hidden");
    if (isHidden) {
      tagPickerPopover.classList.remove("hidden");
      renderComposerTagOptions(tagPickerInput?.value || "");
      setTimeout(() => tagPickerInput?.focus(), 50);
    } else {
      tagPickerPopover.classList.add("hidden");
    }
  });

  closeTagPickerBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    tagPickerPopover?.classList.add("hidden");
  });

  // 点击外部自动关闭标签选择器浮层
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (tagPickerPopover && !tagPickerPopover.classList.contains("hidden")) {
      const container = document.getElementById("tag-picker-container");
      if (container && !container.contains(target)) {
        tagPickerPopover.classList.add("hidden");
      }
    }
  });

  tagPickerInput?.addEventListener("input", () => {
    renderComposerTagOptions(tagPickerInput.value);
  });

  tagPickerInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (tagPickerInput.value.trim()) {
        handleSelectOrCreateComposeTag(tagPickerInput.value);
      }
    }
  });

  tagPickerCreateBtn?.addEventListener("click", () => {
    if (tagPickerInput && tagPickerInput.value.trim()) {
      handleSelectOrCreateComposeTag(tagPickerInput.value);
    }
  });

  tagFilterAllBtn?.addEventListener("click", () => {
    setTagFilter(null);
  });

  // 标签管理器事件绑定
  openTagManagerBtn?.addEventListener("click", openTagManagerModal);
  tagManagerCloseBtn?.addEventListener("click", closeTagManagerModal);
  tagManagerCloseIconBtn?.addEventListener("click", closeTagManagerModal);
  tagManagerModal?.addEventListener("click", (e) => {
    if (e.target === tagManagerModal) closeTagManagerModal();
  });

  tagManagerAddBtn?.addEventListener("click", handleAddNewTagInManager);
  tagManagerNewInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      handleAddNewTagInManager();
    }
  });

  // ===== 编辑已发布动态的标签 (Modal) =====

  function openEditPostTagsModal(post: PostItem) {
    if (!isAuthor || !editPostTagsModal) return;
    editingPost = post;
    editingPostDraftTags = (post.tags || []).map((t) => t.replace(/^#/, "").trim()).filter(Boolean);

    if (editPostTagsExcerpt) {
      editPostTagsExcerpt.textContent = post.content || "(图片动态)";
    }
    if (editPostTagsInput) {
      editPostTagsInput.value = "";
    }

    renderEditPostTagsCurrent();
    renderEditPostTagsOptions();

    editPostTagsModal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeEditPostTagsModal() {
    if (!editPostTagsModal) return;
    editPostTagsModal.classList.add("hidden");
    document.body.style.overflow = "";
    editingPost = null;
    editingPostDraftTags = [];
  }

  function renderEditPostTagsCurrent() {
    if (!editPostTagsCurrent) return;
    editPostTagsCurrent.innerHTML = "";
    if (editingPostDraftTags.length === 0) {
      editPostTagsCurrent.innerHTML = '<span class="text-[10px] text-neutral-300">暂无标签，可从下方点击添加</span>';
      return;
    }
    editingPostDraftTags.forEach((tag) => {
      const chip = document.createElement("span");
      chip.className = "inline-flex items-center gap-1 text-[11px] font-mono bg-neutral-100 text-neutral-800 px-1.5 py-0.5 rounded border border-neutral-200 shadow-2xs";
      chip.innerHTML = `<span>#${tag}</span><button type="button" class="text-neutral-400 hover:text-neutral-800 cursor-pointer p-0.5"><i class="ph ph-x text-[9px]"></i></button>`;
      chip.querySelector("button")?.addEventListener("click", () => {
        editingPostDraftTags = editingPostDraftTags.filter((t) => t !== tag);
        renderEditPostTagsCurrent();
        renderEditPostTagsOptions();
      });
      editPostTagsCurrent.appendChild(chip);
    });
  }

  function renderEditPostTagsOptions() {
    if (!editPostTagsOptions) return;
    editPostTagsOptions.innerHTML = "";
    const filterKw = editPostTagsInput?.value.trim().toLowerCase() || "";
    const filtered = allTags.filter((t) => t.toLowerCase().includes(filterKw));

    if (filtered.length === 0) {
      editPostTagsOptions.innerHTML = '<span class="text-[10px] text-neutral-400 p-1">无匹配标签，可直接在上方输入添加</span>';
      return;
    }

    filtered.forEach((tag) => {
      const isSelected = editingPostDraftTags.includes(tag);
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = isSelected
        ? "inline-flex items-center gap-0.5 text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-900 text-white cursor-pointer select-none"
        : "inline-flex items-center gap-0.5 text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 hover:bg-neutral-200 text-neutral-700 cursor-pointer select-none";
      btn.innerHTML = `${isSelected ? '<i class="ph ph-check text-[9px]"></i>' : ""}#${tag}`;
      btn.addEventListener("click", () => {
        if (isSelected) {
          editingPostDraftTags = editingPostDraftTags.filter((t) => t !== tag);
        } else {
          editingPostDraftTags.push(tag);
        }
        renderEditPostTagsCurrent();
        renderEditPostTagsOptions();
      });
      editPostTagsOptions.appendChild(btn);
    });
  }

  function handleAddNewTagInPostEditor() {
    if (!editPostTagsInput) return;
    const clean = editPostTagsInput.value.replace(/^#/, "").trim();
    if (!clean) return;

    if (!allTags.includes(clean)) {
      allTags.push(clean);
      allTags.sort((a, b) => a.localeCompare(b, "zh-CN"));
      supabase.from("daily_tags").insert([{ name: clean }]).then();
    }

    if (!editingPostDraftTags.includes(clean)) {
      editingPostDraftTags.push(clean);
      renderEditPostTagsCurrent();
    }

    editPostTagsInput.value = "";
    renderEditPostTagsOptions();
  }

  async function handleSaveEditPostTags() {
    if (!editingPost) return;
    const saveBtn = document.getElementById("edit-post-tags-save-btn") as HTMLButtonElement | null;
    const spinner = document.getElementById("edit-post-tags-spinner");
    const saveText = document.getElementById("edit-post-tags-save-text");

    if (saveBtn) saveBtn.disabled = true;
    spinner?.classList.remove("hidden");
    if (saveText) saveText.textContent = "保存中...";

    try {
      const newTags = [...editingPostDraftTags];
      const { error } = await supabase
        .from("daily_posts")
        .update({ tags: newTags })
        .eq("id", editingPost.id);

      if (error) throw error;

      // 1. 同步内存中当前 post 的 tags
      editingPost.tags = newTags;

      // 2. 如果包含新标签，同步 upsert 到 daily_tags 表
      if (newTags.length > 0) {
        try {
          const rows = newTags.map((name) => ({ name }));
          await supabase.from("daily_tags").upsert(rows, { onConflict: "name" });
        } catch (e) {}
      }

      // 3. 原位更新该卡片内部的标签胶囊区，绝不重载整页或切断当前已加载的时间轴
      const postArticle = document.getElementById(`post-${editingPost.id}`);
      if (postArticle) {
        let tagsContainer = postArticle.querySelector(".post-tags-container") as HTMLElement | null;
        if (!tagsContainer) {
          const cardEl = postArticle.querySelector(".bg-white");
          if (cardEl) {
            tagsContainer = document.createElement("div");
            tagsContainer.className = "post-tags-container flex flex-wrap items-center gap-1.5 pt-1";
            const commentsContainer = cardEl.querySelector(".post-comments-container");
            if (commentsContainer) cardEl.insertBefore(tagsContainer, commentsContainer);
            else cardEl.appendChild(tagsContainer);
          }
        }
        if (tagsContainer) {
          renderPostTagsArea(tagsContainer, editingPost);
        }

        // 如果用户当前正在根据某标签进行筛选，且编辑后该动态已不含该筛选标签，优雅淡出移除
        if (currentTagFilter && !newTags.includes(currentTagFilter)) {
          postArticle.style.opacity = "0";
          postArticle.style.transform = "scale(0.98)";
          setTimeout(() => {
            const dayGroup = postArticle.closest(".timeline-day-group");
            postArticle.remove();
            if (dayGroup && dayGroup.children.length === 0) {
              dayGroup.remove();
            }
          }, 200);
        }
      }

      closeEditPostTagsModal();
      // 4. 静默刷新标签筛选栏（更新可用标签池与动态计数），无需刷新时间轴
      await loadAllTags();
    } catch (err: any) {
      console.error("更新动态标签失败:", err);
      alert(`保存失败: ${err.message || "请检查网络或权限"}`);
    } finally {
      if (saveBtn) saveBtn.disabled = false;
      spinner?.classList.add("hidden");
      if (saveText) saveText.textContent = "保存修改";
    }
  }

  // 编辑单条动态标签事件绑定
  editPostTagsCancelBtn?.addEventListener("click", closeEditPostTagsModal);
  editPostTagsCloseIconBtn?.addEventListener("click", closeEditPostTagsModal);
  editPostTagsModal?.addEventListener("click", (e) => {
    if (e.target === editPostTagsModal) closeEditPostTagsModal();
  });
  editPostTagsAddBtn?.addEventListener("click", handleAddNewTagInPostEditor);
  editPostTagsInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      handleAddNewTagInPostEditor();
    }
  });
  editPostTagsInput?.addEventListener("input", () => {
    renderEditPostTagsOptions();
  });
  editPostTagsSaveBtn?.addEventListener("click", handleSaveEditPostTags);

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && editPostTagsModal && !editPostTagsModal.classList.contains("hidden")) {
      closeEditPostTagsModal();
    }
  });

  // 页面滑到底部时自动触发无限滚动加载更早动态
  if (typeof window !== "undefined" && "IntersectionObserver" in window && paginationContainer) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && hasMore && !isLoadingMore) {
          loadMore();
        }
      },
      { rootMargin: "250px" }
    );
    observer.observe(paginationContainer);
  }

  // 初始化执行
  initAuth();
  loadAllTags();
</script>

<style>
  /* 左侧日期平滑过渡效果 */
  :global(.date-col) {
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s ease, filter 0.25s ease;
  }

  /* 默认状态：同一天中第一条（最新一条）高亮呈现（opacity: 1），其余条目保持淡化（opacity: 0.18） */
  :global(.timeline-day-group .timeline-article:first-child .date-col) {
    opacity: 1;
  }
  :global(.timeline-day-group .timeline-article:not(:first-child) .date-col) {
    opacity: 0.18;
  }

  /* 核心联动：只要同日期下有非最新（not:first-child）的卡片被悬停（:hover）或点击激活（.is-active），最新一条（:first-child）立即变浅变淡（opacity: 0.18）！ */
  :global(.timeline-day-group:has(.timeline-article:not(:first-child):hover) .timeline-article:first-child:not(:hover) .date-col),
  :global(.timeline-day-group:has(.timeline-article:not(:first-child).is-active) .timeline-article:first-child:not(.is-active) .date-col) {
    opacity: 0.18 !important;
  }

  /* 当前被悬停或处于选中激活状态的任意卡片，其对应左侧日期 100% 显现并加深聚焦 */
  :global(.timeline-day-group .timeline-article:hover .date-col),
  :global(.timeline-day-group .timeline-article.is-active .date-col) {
    opacity: 1 !important;
  }
</style>
