---
import { getCollection, render } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../utils/date";

// 获取所有文章，生成动态路由
export async function getStaticPaths() {
  const filterDrafts = ({ data }: any) => import.meta.env.DEV || !data.draft;
  
  const techPosts = await getCollection('tech', filterDrafts);
  const dailyPosts = await getCollection('daily', filterDrafts);
  const diaryPosts = await getCollection('diary', filterDrafts);

  const allPosts = [
    ...techPosts.map(p => ({ ...p, category: 'Tech Blog' })),
    ...dailyPosts.map(p => ({ ...p, category: 'Daily Notes' })),
    ...diaryPosts.map(p => ({ ...p, category: 'Dev Diary' }))
  ];

  return allPosts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Calculate dynamic reading time (assuming ~400 Chinese characters/English words per minute)
const cleanBody = post.body.replace(/\s+/g, '');
const readingTime = Math.max(1, Math.round(cleanBody.length / 350));
---

<BaseLayout title={`${post.data.title} | Mizuki`}>
    <!-- Main Content -->
    <main class="flex-grow max-w-3xl mx-auto px-6 py-8 w-full animate-fade-in">
        
        <!-- 返回上级 -->
        <div class="mb-10">
            <a href="/blog" class="inline-flex items-center space-x-2 text-sm font-mono text-neutral-400 hover:text-neutral-900 transition-colors group">
                <i class="ph ph-arrow-left transition-transform group-hover:-translate-x-1"></i>
                <span>cd ../notes</span>
            </a>
        </div>

        <!-- 文章头部元数据 -->
        <header class="mb-12">
            <h1 class="text-3xl font-medium tracking-tight text-neutral-900 mb-4 leading-snug">
                {post.data.title}
            </h1>
            <div class="flex flex-wrap items-center gap-4 text-sm font-mono text-neutral-500 border-b border-neutral-200 pb-6">
                <time datetime={formatDate(post.data.date)} class="flex items-center gap-1.5">
                    <i class="ph ph-calendar-blank"></i> {formatDate(post.data.date)}
                </time>
                <div class="flex items-center gap-1.5">
                    <i class="ph ph-folder"></i> {post.category}
                </div>
                <div class="flex items-center gap-1.5">
                    <i class="ph ph-clock"></i> {readingTime} min read
                </div>
            </div>
        </header>

        <!-- Markdown 渲染内容区 (.prose) -->
        <article class="prose w-full">
            <Content />
        </article>

        <!-- 底部导航标签 -->
        {post.data.tags && post.data.tags.length > 0 && (
            <div class="mt-16 pt-8 border-t border-neutral-200 flex flex-wrap gap-2">
                {post.data.tags.map((tag: string) => (
                    <span class="px-2 py-1 bg-neutral-100 text-neutral-600 text-xs font-mono rounded border border-neutral-200">
                        # {tag}
                    </span>
                ))}
            </div>
        )}
    </main>
</BaseLayout>

<style>
    /* 专门为渲染 Markdown 内容定制的排版样式 (类似 Tailwind Typography) */
    .prose h2 {
        font-size: 1.5rem;
        font-weight: 500;
        color: #171717;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 0.5rem;
    }
    .prose h3 {
        font-size: 1.125rem;
        font-weight: 500;
        color: #171717;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }
    .prose p {
        margin-bottom: 1.5rem;
        line-height: 1.75;
        color: #404040;
    }
    .prose ul {
        list-style-type: disc;
        padding-left: 1.25rem;
        margin-bottom: 1.5rem;
        color: #404040;
        line-height: 1.75;
    }
    .prose li {
        margin-bottom: 0.5rem;
    }
    .prose blockquote {
        border-left: 3px solid #d4d4d4;
        padding-left: 1.25rem;
        color: #737373;
        margin-bottom: 1.5rem;
        font-style: italic;
    }
    /* 行内代码 */
    .prose code:not(pre code) {
        font-family: 'JetBrains Mono', monospace;
        background-color: #f5f5f5;
        padding: 0.2rem 0.4rem;
        border-radius: 0.25rem;
        font-size: 0.85em;
        border: 1px solid #e5e5e5;
        color: #262626;
    }
    /* 代码块 */
    .prose pre {
        background-color: #171717;
        color: #fafafa;
        padding: 1.25rem;
        border-radius: 0.25rem;
        overflow-x: auto;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
        line-height: 1.5;
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .prose a {
        color: #171717;
        text-decoration: underline;
        text-decoration-color: #d4d4d4;
        text-underline-offset: 4px;
        transition: text-decoration-color 0.2s;
    }
    .prose a:hover {
        text-decoration-color: #171717;
    }
</style>

