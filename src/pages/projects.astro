---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateYY } from "../utils/date";

const filterDrafts = ({ data }: any) => import.meta.env.DEV || !data.draft;

const projects = await getCollection("projects");
const allPosts = [
    ...await getCollection("tech", filterDrafts),
    ...await getCollection("daily", filterDrafts),
    ...await getCollection("diary", filterDrafts)
];

const sortedProjects = await Promise.all(
    projects.sort((a, b) => b.data.order - a.data.order).map(async (project) => {
        const { Content } = await render(project);
        const relatedPosts = allPosts
            .filter(post => post.data.project === project.id)
            .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
        return {
            ...project,
            Content,
            relatedPosts
        };
    })
);
---

<BaseLayout title="Mizuki | Projects">
    <!-- Main Content -->
    <main
        class="flex-grow max-w-3xl mx-auto px-6 py-12 w-full animate-fade-in"
    >
        <!-- 标题区域 -->
        <div
            class="flex items-baseline justify-between border-b border-neutral-200 pb-4 mb-10"
        >
            <h1 class="text-2xl font-medium text-neutral-900">Projects</h1>
            <span class="text-xs font-mono text-neutral-400"
                >/ All Selected Work</span
            >
        </div>

        {sortedProjects.length > 0 ? (
            <div class="space-y-6">
                {sortedProjects.map((project) => (
                    <details
                        class="group bg-white border border-neutral-200 rounded-sm overflow-hidden transition-all duration-200"
                        id={project.id}
                    >
                        <summary
                            class="p-6 cursor-pointer hover:bg-neutral-50 transition-colors block"
                        >
                            <div class="flex justify-between items-start mb-2">
                                <h3
                                    class="text-lg font-medium text-neutral-900 group-hover:underline decoration-neutral-300 underline-offset-4"
                                >
                                    {project.data.title}
                                </h3>
                                <span
                                    class="text-neutral-400 group-open:rotate-45 transition-transform duration-200"
                                >
                                    <i class="ph ph-plus text-xl"></i>
                                </span>
                            </div>
                            <p class="text-neutral-600 text-sm mb-4 pr-8">
                                {project.data.description}
                            </p>
                            <div
                                class="flex gap-3 font-mono text-xs text-neutral-500"
                            >
                                {project.data.tags.map((tag) => (
                                    <span
                                        class="bg-neutral-100 px-2 py-0.5 rounded border border-neutral-200"
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </summary>

                        <div
                            class="px-6 pb-6 pt-4 border-t border-neutral-100 bg-neutral-50/50 text-sm text-neutral-600 space-y-4"
                        >
                            <div class="prose max-w-none text-neutral-600">
                                <project.Content />
                            </div>

                            <div
                                class="pt-4 flex flex-col gap-4 border-t border-neutral-200/60 mt-4"
                            >
                                {(project.data.github || project.data.docs) && (
                                    <div class="flex gap-6">
                                        {project.data.github && (
                                            <a
                                                href={project.data.github}
                                                target="_blank"
                                                class="flex items-center gap-1.5 font-mono text-neutral-700 hover:text-neutral-900 transition-colors group/link"
                                            >
                                                <i class="ph ph-github-logo text-lg"></i>
                                                <span
                                                    class="group-hover/link:underline decoration-neutral-400 underline-offset-4"
                                                >Repository</span>
                                            </a>
                                        )}
                                        {project.data.docs && project.data.docs !== "#" && project.data.docs !== "" && (
                                            <a
                                                href={project.data.docs}
                                                target="_blank"
                                                class="flex items-center gap-1.5 font-mono text-neutral-700 hover:text-neutral-900 transition-colors group/link"
                                            >
                                                <i class="ph ph-book-open-text text-lg"></i>
                                                <span
                                                    class="group-hover/link:underline decoration-neutral-400 underline-offset-4"
                                                >Documentation</span>
                                            </a>
                                        )}
                                    </div>
                                )}

                                {project.relatedPosts && project.relatedPosts.length > 0 && (
                                    <div
                                        class="bg-white/60 p-3 rounded-sm border border-neutral-200/60 mt-1"
                                    >
                                        <div
                                            class="flex items-center gap-2 mb-3 text-neutral-900 border-b border-neutral-100 pb-2"
                                        >
                                            <i class="ph ph-notebook text-base"></i>
                                            <h5
                                                class="text-xs font-mono font-medium uppercase tracking-wider"
                                            >
                                                Related Dev Diaries
                                            </h5>
                                            <span
                                                class="ml-auto text-[10px] font-mono text-neutral-400 bg-neutral-100 px-1.5 py-0.5 rounded"
                                            >Total: {project.relatedPosts.length}</span>
                                        </div>
                                        <ul class="space-y-2.5">
                                            {project.relatedPosts.slice(0, 3).map((post) => (
                                                <li
                                                    class="flex items-start justify-between group/note"
                                                >
                                                    <a
                                                        href={`/blog/${post.id}`}
                                                        class="text-neutral-600 text-sm group-hover/note:text-neutral-900 group-hover/note:underline decoration-neutral-300 underline-offset-4 transition-all truncate pr-4"
                                                    >
                                                        {post.data.title}
                                                    </a>
                                                    <span
                                                        class="font-mono text-[11px] text-neutral-400 shrink-0 mt-0.5"
                                                    >
                                                        {formatDateYY(post.data.date)}
                                                    </span>
                                                </li>
                                            ))}
                                        </ul>
                                        {project.relatedPosts.length > 3 && (
                                            <div
                                                class="mt-3 pt-2 border-t border-neutral-100 border-dashed"
                                            >
                                                <a
                                                    href="/blog"
                                                    class="block text-center font-mono text-xs text-neutral-400 hover:text-neutral-900 transition-colors"
                                                >
                                                    + View {project.relatedPosts.length - 3} older notes in Blog ->
                                                </a>
                                            </div>
                                        )}
                                    </div>
                                )}
                            </div>
                        </div>
                    </details>
                ))}
            </div>
        ) : (
            <div class="text-center py-20 text-neutral-400 font-mono text-sm">
                <i class="ph ph-ghost text-4xl mb-2"></i>
                <p>No projects listed yet.</p>
            </div>
        )}
    </main>
</BaseLayout>

{sortedProjects.length > 0 && (
    <script is:inline>
        // Auto-expand and scroll to project on load
        function handleAutoExpand() {
            const params = new URLSearchParams(window.location.search);
            const projectId = params.get('id') || window.location.hash.substring(1);
            
            if (projectId) {
                const detailsElement = document.getElementById(projectId);
                if (detailsElement && detailsElement.tagName === 'DETAILS') {
                    detailsElement.setAttribute('open', '');
                    // Smooth scroll to the details element
                    setTimeout(() => {
                        detailsElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 100);
                }
            }
        }

        // Run on load and also on hashchange if hash changes
        window.addEventListener('DOMContentLoaded', handleAutoExpand);
        window.addEventListener('hashchange', handleAutoExpand);
    </script>
)}

<style>
    /* Hide the default details marker */
    details > summary {
        list-style: none;
    }
    details > summary::-webkit-details-marker {
        display: none;
    }

    /* Project Details Markdown Styling */
    .prose h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: #171717;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }
    .prose p {
        line-height: 1.625;
        color: #525252;
        margin-bottom: 1rem;
    }
    .prose ul {
        list-style-type: disc;
        padding-left: 1.25rem;
        margin-bottom: 1rem;
        color: #525252;
        line-height: 1.625;
    }
    .prose li {
        margin-bottom: 0.25rem;
    }
</style>

