---
import { getEntry, render } from "astro:content";
import { siteConfig } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

// Fetch the about page markdown entry
const aboutEntry = await getEntry("about", "me");
const { Content } = aboutEntry ? await render(aboutEntry) : { Content: null };
---

<BaseLayout title="Mizuki | About">
    <!-- Main Content -->
    <main
        class="flex-grow max-w-3xl mx-auto px-6 py-12 w-full animate-fade-in"
    >
        <!-- 头部信息区，整体居中 -->
        <div class="flex flex-col items-center text-center space-y-6">
            <!-- About Me 字样 -->
            <h1 class="text-2xl font-medium text-neutral-900">About me</h1>

            <!-- 头像 (进一步缩小尺寸 w-20 h-20) -->
            <div
                class="w-20 h-20 rounded-full overflow-hidden border border-neutral-200 bg-neutral-50 flex items-center justify-center shadow-sm"
            >
                {siteConfig.avatar ? (
                    <img
                        src={siteConfig.avatar}
                        alt={siteConfig.name}
                        class="w-full h-full object-cover"
                    />
                ) : (
                    <i class="ph ph-user text-4xl text-neutral-300"></i>
                )}
            </div>

            <!-- 名字与 GitHub ID (同一行排布) -->
            <div class="flex items-center justify-center space-x-2">
                <h2
                    class="text-2xl font-semibold tracking-tight text-neutral-900"
                >
                    {siteConfig.name}
                </h2>
                <span class="text-neutral-300 font-mono">/</span>
                <a
                    href={`https://github.com/${siteConfig.github}`}
                    target="_blank"
                    class="text-neutral-400 hover:text-neutral-900 font-mono text-sm transition-colors mt-1"
                >
                    @{siteConfig.github}
                </a>
            </div>

            <!-- 标签 -->
            {siteConfig.tags && siteConfig.tags.length > 0 && (
                <div
                    class="flex flex-wrap justify-center gap-2 text-sm font-mono pt-2"
                >
                    {siteConfig.tags.map((tag) => (
                        <span class="px-2.5 py-1 bg-neutral-100 text-neutral-700 rounded-md border border-neutral-200">
                            {tag}
                        </span>
                    ))}
                </div>
            )}
        </div>

        <!-- 简洁的横线分割 -->
        <hr class="border-t border-neutral-200 my-12 w-full" />

        <!-- 详情信息区 (去掉了大框，改为纯净的文本排版) -->
        <div
            class="prose w-full text-neutral-600 leading-relaxed text-base md:text-lg"
        >
            {Content && <Content />}
        </div>
    </main>
</BaseLayout>

<style>
    /* Custom Markdown Prose styles for Q&A formatting */
    .prose h1 {
        display: none; /* Hide top title since we already have "About me" header */
    }
    .prose h2 {
        font-size: 1.25rem;
        font-weight: 500;
        color: #171717;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 0.35rem;
    }
    .prose p {
        margin-bottom: 1.25rem;
        line-height: 1.625;
        color: #404040;
    }
    .prose ul {
        list-style-type: disc;
        padding-left: 1.25rem;
        margin-bottom: 1.25rem;
        color: #404040;
        line-height: 1.625;
    }
    .prose li {
        margin-bottom: 0.35rem;
    }
</style>

